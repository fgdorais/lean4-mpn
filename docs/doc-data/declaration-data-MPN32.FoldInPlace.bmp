lass=\"fn\">β</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">f</span> : <span class=\"fn\">(<span class=\"fn\">k</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>) → <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">k</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\"><span class=\"fn\">len</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span> → <span class=\"fn\"><a href=\"./Init/Prelude.html#UInt64\">UInt64</a> → <span class=\"fn\"><span class=\"fn\">β</span> → <a href=\"./Init/Prelude.html#UInt64\">UInt64</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">β</span></span></span></span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h</span> : <span class=\"fn\"><span class=\"fn\">start</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\"><span class=\"fn\">len</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#LE.le\">≤</a> <span class=\"fn\"><span class=\"fn\">a</span>.<a href=\"./ScalarArray/UInt64/Basic.html#ScalarArray.UInt64Array.size\">size</a></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./ScalarArray/UInt64/Basic.html#ScalarArray.UInt64Array\">UInt64Array</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">β</span></div></div>","info":{"doc":"Replaces each element of `a` from index `start` for `len` elements while threading an\naccumulator: for each `k < len`, the element `x` at `start + k` becomes the first component of\n`f k hk x b`, whose second component is the next accumulator. Returns the new array and the last\naccumulator. The compiler runs `foldlInPlace` on the slice of those elements instead\n(`foldInPlace_eq_fast`), which stores in place without checks.","docLink":"./MPN32/FoldInPlace.html#ScalarArray.UInt64Array.foldInPlace","kind":"def","line":41,"name":"ScalarArray.UInt64Array.foldInPlace","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN32/FoldInPlace.lean#L41-L52"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN32/FoldInPlace.html#ScalarArray.UInt64Array.foldInPlace.loop\"><span class=\"name\">ScalarArray</span>.<span class=\"name\">UInt64Array</span>.<span class=\"name\">foldInPlace</span>.<span class=\"name\">loop</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">β</span> : <a href=\"./foundational_types.html\">Type</a> v}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">len'</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">f</span> : <span class=\"fn\">(<span class=\"fn\">k</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>) → <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">k</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\"><span class=\"fn\">len'</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span> → <span class=\"fn\"><a href=\"./Init/Prelude.html#UInt64\">UInt64</a> → <span class=\"fn\"><span class=\"fn\">β</span> → <a href=\"./Init/Prelude.html#UInt64\">UInt64</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">β</span></span></span></span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">start </span><span class=\"fn\">len</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a