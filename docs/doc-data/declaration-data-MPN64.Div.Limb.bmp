4/Arch/UIntArray.html#ScalarArray.UInt64Array.USlice.array\">array</a></span>.<a href=\"./ScalarArray/UInt64/Basic.html#ScalarArray.UInt64Array.size\">size</a></span></div></div>","info":{"doc":"","docLink":"./MPN64/Div/Limb.html#MPN.W64.size_divRem1With","kind":"theorem","line":36,"name":"MPN.W64.size_divRem1With","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Div/Limb.lean#L36-L38"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN64/Div/Limb.html#MPN.W64.divRem1With\"><span class=\"name\">MPN</span>.<span class=\"name\">W64</span>.<span class=\"name\">divRem1With</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">t </span><span class=\"fn\">tu</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">r </span><span class=\"fn\">a</span> : <a href=\"./MPN64/Arch/UIntArray.html#ScalarArray.UInt64Array.USlice\">ScalarArray.UInt64Array.USlice</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">d</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./ScalarArray/UInt64/Basic.html#ScalarArray.UInt64Array\">ScalarArray.UInt64Array</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Init/Prelude.html#UInt64\">UInt64</a></div></div>","info":{"doc":"Writes the limbs of `a / d` into `r` and returns `a % d`, on the first `min r.size a.size` limbs,\nlike GMP's `mpn_divrem_1`. It requires `0 < d`. It takes the steps with the reciprocal from `t`\nlimbs for a normalized `d`, and from `tu` limbs for another, normalized by a shift.","docLink":"./MPN64/Div/Limb.html#MPN.W64.divRem1With","kind":"def","line":27,"name":"MPN.W64.divRem1With","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63