eneric/Ops.html#MPN.NatOps.val\">val</a></span> <span class=\"fn\">b</span>)</span></span></div></div>","info":{"doc":"","docLink":"./MPN/Generic/HGCD.html#MPN.NatOps.gcd_hgcdReduce","kind":"theorem","line":642,"name":"MPN.NatOps.gcd_hgcdReduce","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Generic/HGCD.lean#L642-L652"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Generic/HGCD.html#MPN.NatOps.hgcdReduce\"><span class=\"name\">MPN</span>.<span class=\"name\">NatOps</span>.<span class=\"name\">hgcdReduce</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">o</span> : <span class=\"fn\"><a href=\"./MPN/Generic/Ops.html#MPN.NatOps\">NatOps</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">base</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Nat\">Nat</a> → <span class=\"fn\"><span class=\"fn\">α</span> → <span class=\"fn\">α</span> → <span class=\"fn\"><a href=\"./MPN/Generic/HGCD.html#MPN.Mat2\">Mat2</a> <span class=\"fn\">α</span></span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span></span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">T</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a </span><span class=\"fn\">b</span> : <span class=\"fn\">α</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">α</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span></div></div>","info":{"doc":"One reduction of `a ≥ b` for the greatest common divisor: the numbers of `hgcd`, the larger first.\nIt keeps the greatest common divisor (`gcd_hgcdReduce`); the caller checks that they got smaller.","docLink":"./MPN/Generic/HGCD.html#MPN.NatOps.hgcdReduce","kind":"def","line":633,"name":"MPN.NatOps.hgcdReduce","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Generic/HGCD.lean#L633-L640"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Generic/HGCD.html#MPN.NatOps.hgcd_ok\"><span class=\"name\">MPN</span>.<span class=\"name\">NatOps</span>.<span class=\"name\">hgcd_ok</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">o</span> : <span class=\"fn\"><a href=\"./MPN/Generic/Ops.html#MPN.NatOps\">NatOps</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">base</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Nat\">Nat</a> → <span class=\"fn\"><span class=\"fn\">α</span> → <span class=\"fn\">α</span> → <span class=\"fn\"><a href=\"./MPN/Generic/HGCD.html#MPN.Mat2\">Mat2</a> <span class=\"fn\">α</span></span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span></span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hbase</span> : <span class=\"fn\">∀ (<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>) (<span class=\"fn\">a </span><span class=\"fn\">b</span> : <span class=\"fn\">α</span>), <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">o</span>.<a href=\"./MPN/Generic/HGCD.html#MPN.NatOps.HgcdOK\">HgcdOK</a></span> <span class=\"fn\">a</span> <span class=\"fn\">b</span> <span class=\"fn\">(<span class=\"fn\">base</span> <span class=\"fn\">s</span> <span class=\"fn\">a</span> <span class=\"fn\">b</span>)</span></span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">T</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a </span><span class=\"fn\">b</span> : <span class=\"fn\">α</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">o</span>.<a href=\"./MPN/Generic/HGCD.html#MPN.NatOps.HgcdOK\">HgcdOK</a></span> <span class=\"fn\">a</span> <span class=\"fn\">b</span> <span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">o</span>.<a href=\"./MPN/Generic/HGCD.html#MPN.NatOps.hgcd\">hgcd</a></span> <span class=\"fn\">base</span> <span class=\"fn\">T</span> <span class=\"fn\">a</span> <span class=\"fn\">b</span>)</span></span></div></div>","info":{"doc":"","docLink":"./MPN/Generic/HGCD.html#MPN.NatOps.hgcd_ok","kind":"theorem","line":578,"name":"MPN.NatOps.hgcd_ok","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Generic/HGCD.lean#L578-L631"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Generic/HGCD.html#MPN.NatOps.hgcd\"><span class=\"name\">MPN</span>.<span class=\"name\">NatOps</span>.<span class=\"name\">hgcd</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">o</span> : <span class=\"fn\"><a href=\"./MPN/Generic/Ops.html#MPN.NatOps\">NatOps</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">base</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Nat\">Nat</a> → <span class=\"fn\"><span class=\"fn\">α</span> → <span class=\"fn\">α</span> → <span class=\"fn\"><a href=\"./MPN/Generic/HGCD.html#MPN.Mat2\">Mat2</a> <span class=\"fn\">α</span></span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span></span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">T</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a </span><span class=\"fn\">b</span> : <span class=\"fn\">α</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./MPN/Generic/HGCD.html#MPN.Mat2\">Mat2</a> <span class=\"fn\">α</span></span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span></div></div>","info":{"doc":"Half-gcd: the matrix of Euclid's steps that brings `a ≥ b`, of `n` limbs, below `Bˢ` with\n`s = ⌊n / 2⌋ + 1`, or close to it, and the numbers it brings them to. Up to `T` limbs by the\ninstance's `base s a b` (`stepBase`, for one); above, the matrix and numbers of the top `n - s`\nlimbs, recursively, extended to `a` and `b` with products by their low `s` limbs (`applySplit`),\nthen one step of Euclid's algorithm, then the same for the top limbs of what is left. A matrix\nfrom top limbs that went too far for the full numbers is dropped. Only the determinant and the\nexact relation are proved (`hgcd_ok`): the caller checks how far the numbers came down.","docLink":"./MPN/Generic/HGCD.html#MPN.NatOps.hgcd","kind":"def","line":539,"name":"MPN.NatOps.hgcd","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Generic/HGCD.lean#L539-L576"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Generic/HGCD.html#MPN.NatOps.smallBase_ok\"><span class=\"name\">MPN</span>.<span class=\"name\">NatOps</span>.<span class=\"name\">smallBase_ok</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">o</span> : <span class=\"fn\"><a href=\"./MPN/Generic/Ops.html#MPN.NatOps\">NatOps</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">B</span> : <span class=\"fn\"><span class=\"fn\">o</span>.<a href=\"./MPN/Generic/HGCD.html#MPN.NatOps.SmallSteps\">SmallSteps</a></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a </span><span class=\"fn\">b</span> : <span class=\"fn\">α</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">o</span>.<a href=\"./MPN/Generic/HGCD.html#MPN.NatOps.HgcdOK\">HgcdOK</a></span> <span class=\"fn\">a</span> <span class=\"fn\">b</span> <span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">o</span>.<a href=\"./MPN/Generic/HGCD.html#MPN.NatOps.smallBase\">smallBase</a></span> <span class=\"fn\">B</span> <span class=\"fn\">s</span> <span class=\"fn\">a</span> <span class=\"fn\">b</span>)</span></span></div></div>","info":{"doc":"","docLink":"./MPN/Generic/HGCD.html#MPN.NatOps.smallBase_ok","kind":"theorem","line":535,"name":"MPN.NatOps.smallBase_ok","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Generic/HGCD.lean#L535-L537"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Generic/HGCD.html#MPN.NatOps.smallBase\"><span class=\"name\">MPN</span>.<span class=\"name\">NatOps</span>.<span class=\"name\">smallBase</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">o</span> : <span class=\"fn\"><a href=\"./MPN/Generic/Ops.html#MPN.NatOps\">NatOps</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">B</span> : <span class=\"fn\"><span class=\"fn\">o</span>.<a href=\"./MPN/Generic/HGCD.html#MPN.NatOps.SmallSteps\">SmallSteps</a></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a </span><span class=\"fn\">b</span> : <span class=\"fn\">α</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./MPN/Generic/HGCD.html#MPN.Mat2\">Mat2</a> <span class=\"fn\">α</span></span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span></div></div>","info":{"doc":"`smallLoop` from the identity matrix, as a base case for `hgcd`.","docLink":"./MPN/Generic/HGCD.html#MPN.NatOps.smallBase","kind":"def","line":531,"name":"MPN.NatOps.smallBase","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Generic/HGCD.lean#L531-L533"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Generic/HGCD.html#MPN.NatOps.small