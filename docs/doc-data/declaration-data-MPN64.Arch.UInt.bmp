.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HMul.hMul\">*</a> <span class=\"fn\">2</span> <a href=\"./Init/Prelude.html#HPow.hPow\">^</a> <span class=\"fn\">64</span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\"><span class=\"fn\">lo</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span></div></div>","info":{"doc":"The remainder of `hi β + lo` by `d`, for `hi < d`, from the quotient `q = div2 hi lo d`.","docLink":"./MPN64/Arch/UInt.html#UInt64.toNat_div2_rem","kind":"theorem","line":118,"name":"UInt64.toNat_div2_rem","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Arch/UInt.lean#L118-L143"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN64/Arch/UInt.html#UInt64.toNat_div2\"><span class=\"name\">UInt64</span>.<span class=\"name\">toNat_div2</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hi </span><span class=\"fn\">lo </span><span class=\"fn\">d</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h</span> : <span class=\"fn\"><span class=\"fn\">hi</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\"><span class=\"fn\">d</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">hi</span>.<a href=\"./MPN64/Arch/UInt.html#UInt64.div2\">div2</a></span> <span class=\"fn\">lo</span> <span class=\"fn\">d</span>)</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> (<span class=\"fn\"><span class=\"fn\">hi</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HMul.hMul\">*</a> <span class=\"fn\">2</span> <a href=\"./Init/Prelude.html#HPow.hPow\">^</a> <span class=\"fn\">64</span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\"><span class=\"fn\">lo</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span>) <a href=\"./Init/Prelude.html#HDiv.hDiv\">/</a> <span class=\"fn\"><span class=\"fn\">d</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span></div></div>","info":{"doc":"","docLink":"./MPN64/Arch/UInt.html#UInt64.toNat_div2","kind":"theorem","line":106,"name":"UInt64.toNat_div2","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Arch/UInt.lean#L106-L116"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN64/Arch/UInt.html#UInt64.div2\"><span class=\"name\">UInt64</span>.<span class=\"name\">div2</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hi </span><span class=\"fn\">lo </span><span class=\"fn\">d</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#UInt64\">UInt64</a></div></div>","info":{"doc":"The low word of the quotient of `hi β + lo` by `d`, where `β = 2⁶⁴`, or `0` when `d = 0`. When\n`hi < d` the quotient fits in a word, and `lo - q d` is the remainder (`toNat_div2_rem`).","docLink":"./MPN64/Arch/UInt.html#UInt64.div2","kind":"def","line":97,"name":"UInt64.div2","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Arch/UInt.lean#L97-L104"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN64/Arch/UInt.html#UInt64.toNat_mulh\"><span class=\"name\">UInt64</span>.<span class=\"name\">toNat_mulh</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x </span><span class=\"fn\">y</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./MPN64/Arch/UInt.html#UInt64.mulh\">mulh</a></span> <span class=\"fn\">y</span>)</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HMul.hMul\">*</a> <span class=\"fn\"><span class=\"fn\">y</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HDiv.hDiv\">/</a> <span class=\"fn\">2</span> <a href=\"./Init/Prelude.html#HPow.hPow\">^</a> <span class=\"fn\">64</span></div></div>","info":{"doc":"","docLink":"./MPN64/Arch/UInt.html#UInt64.toNat_mulh","kind":"theorem","line":91,"name":"UInt64.toNat_mulh","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Arch/UInt.lean#L91-L95"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN64/Arch/UInt.html#UInt64.mulh\"><span class=\"name\">UInt64</span>.<span class=\"name\">mulh</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x </span><span class=\"fn\">y</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#UInt64\">UInt64</a></div></div>","info":{"doc":"The high word of `x * y`.","docLink":"./MPN64/Arch/UInt.html#UInt64.mulh","kind":"def","line":85,"name":"UInt64.mulh","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Arch/UInt.lean#L85-L89"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN64/Arch/UInt.html#UInt64.toNat_subb\"><span class=\"name\">UInt64</span>.<span class=\"name\">toNat_subb</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">b </span><span class=\"fn\">x </span><span class=\"fn\">y</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">b</span>.<a href=\"./MPN64/Arch/UInt.html#UInt64.subb\">subb</a></span> <span class=\"fn\">x</span> <span class=\"fn\">y</span>)</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> (<span class=\"fn\"><span class=\"fn\">b</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <a href=\"./Init/Prelude.html#ite\">if</a> <span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\"><span class=\"fn\">y</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#ite\">then</a> <span class=\"fn\">1</span> <a href=\"./Init/Prelude.html#ite\">else</a> <span class=\"fn\">0</span>) <a href=\"./Init/Prelude.html#HMod.hMod\">%</a> <span class=\"fn\">2</span> <a href=\"./Init/Prelude.html#HPow.hPow\">^</a> <span class=\"fn\">64</span></div></div>","info":{"doc":"","docLink":"./MPN64/Arch/UInt.html#UInt64.toNat_subb","kind":"theorem","line":81,"name":"UInt64.toNat_subb","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Arch/UInt.lean#L81-L83"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN64/Arch/UInt.html#UInt64.subb\"><span class=\"name\">UInt64</span>.<span class=\"name\">subb</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">b </span><span class=\"fn\">x </span><span class=\"fn\">y</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#UInt64\">UInt64</a></div></div>","info":{"doc":"`subh` written in C as `b + (x < y)`: a compare and an add with carry. On the chain of a\nsubtraction's borrow (`subC`) the double-width form of `subh` compiles to one more operation, a\nnegation; inside the longer expressions of the multiply-subtract and the linear combinations of the\ngcd, `subh`'s form compiles better.","docLink":"./MPN64/Arch/UInt.html#UInt64.subb","kind":"def","line":70,"name":"UInt64.subb","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Arch/UInt.lean#L70-L79"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN64/Arch/UInt.html#UInt64.toNat_subh\"><span class=\"name\">UInt64</span>.<span class=\"name\">toNat_subh</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">b </span><span class=\"fn\">x </span><span class=\"fn\">y</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">b</span>.<a href=\"./MPN64/Arch/UInt.html#UInt64.subh\">subh</a></span> <span class=\"fn\">x</span> <span class=\"fn\">y</span>)</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> (<span class=\"fn\"><span class=\"fn\">b</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <a href=\"./Init/Prelude.html#ite\">if</a> <span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\"><span class=\"fn\">y</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#ite\">then</a> <span class=\"fn\">1</span> <a href=\"./Init/Prelude.html#ite\">else</a> <span class=\"fn\">0</span>) <a href=\"./Init/Prelude.html#HMod.hMod\">%</a> <span class=\"fn\">2</span> <a href=\"./Init/Prelude.html#HPow.hPow\">^</a> <span class=\"fn\">64</span></div></div>","info":{"doc":"","docLink":"./MPN64/Arch/UInt.html#UInt64.toNat_subh","kind":"theorem","line":53,"name":"UInt64.toNat_subh","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Arch/UInt.lean#L53-L68"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN64/Arch/UInt.html#UInt64.subh\"><span class=\"name\">UInt64</span>.<span class=\"name\">subh</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">b </span><span class=\"fn\">x </span><span class=\"fn\">y</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#UInt64\">UInt64</a></div></div>","info":{"doc":"Subtracts the high word of `x - y`, computed in double width, from `b`. The high word is all ones\nwhen `x - y` borrows, so this adds the borrow to `b`.","docLink":"./MPN64/Arch/UInt.html#UInt64.subh","kind":"def","line":44,"name":"UInt64.subh","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Arch/UInt.lean#L44-L51"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN64/Arch/UInt.html#UInt64.toNat_addh\"><span class=\"name\">UInt64</span>.<span class=\"name\">toNat_addh</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c </span><span class=\"fn\">x </span><span class=\"fn\">y</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">c</span>.<a href=\"./MPN64/Arch/UInt.html#UInt64.addh\">addh</a></span> <span class=\"fn\">x</span> <span class=\"fn\">y</span>)</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> (<span class=\"fn\"><span class=\"fn\">c</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> (<span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\"><span class=\"fn\">y</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></span>) <a href=\"./Init/Prelude.html#HDiv.hDiv\">/</a> <span class=\"fn\">2</span> <a href=\"./Init/Prelude.html#HPow.hPow\">^</a> <span class=\"fn\">64</span>) <a href=\"./Init/Prelude.html#HMod.hMod\">%</a> <span class=\"fn\">2</span> <a href=\"./Init/Prelude.html#HPow.hPow\">^</a> <span class=\"fn\">64</span></div></div>","info":{"doc":"","docLink":"./MPN64/Arch/UInt.html#UInt64.toNat_addh","kind":"theorem","line":38,"name":"UInt64.toNat_addh","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Arch/UInt.lean#L38-L42"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN64/Arch/UInt.html#UInt64.addh\"><span class=\"name\">UInt64</span>.<span class=\"name\">addh</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c </span><span class=\"fn\">x </span><span class=\"fn\">y</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#UInt64\">UInt64</a></div></div>","info":{"doc":"Adds the high word of `x + y`, which is its carry out, to `c`.","docLink":"./MPN64/Arch/UInt.html#UInt64.addh","kind":"def","line":32,"name":"UInt64.addh","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN64/Arch/UInt.lean#L32-L36"}}],"imports":["Init","MPN.WordH"],"instances":[],"name":"MPN64.Arch.UInt"}