/Natural.html#MPN.GNat.instDecidableEq\"><span class=\"name\">MPN</span>.<span class=\"name\">GNat</span>.<span class=\"name\">instDecidableEq</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">A</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.NatLimbs\">NatLimbs</a> <span class=\"fn\">A</span></span>]</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#DecidableEq\">DecidableEq</a> <span class=\"fn\">(<a href=\"./MPN/Natural.html#MPN.GNat\">GNat</a> <span class=\"fn\">A</span>)</span></span></div></div>","info":{"doc":"","docLink":"./MPN/Natural.html#MPN.GNat.instDecidableEq","kind":"instance","line":823,"name":"MPN.GNat.instDecidableEq","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN/Natural.lean#L823-L823"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Natural.html#MPN.GNat.ofString?_eq\"><span class=\"name\">MPN</span>.<span class=\"name\">GNat</span>.<span class=\"name\">ofString?_eq</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">A</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.NatLimbs\">NatLimbs</a> <span class=\"fn\">A</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.GNat.ofString?\">ofString?</a> <span class=\"fn\">s</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><a href=\"./Init/Prelude.html#Option.map\">Option.map</a> <a href=\"./MPN/Natural.html#MPN.GNat.ofNat\">ofNat</a> <span class=\"fn\"><span class=\"fn\">s</span>.<a href=\"./Init/Data/String/Search.html#String.toNat?\">toNat?</a></span></span></div></div>","info":{"doc":"","docLink":"./MPN/Natural.html#MPN.GNat.ofString?_eq","kind":"theorem","line":810,"name":"MPN.GNat.ofString?_eq","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN/Natural.lean#L810-L819"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Natural.html#MPN.GNat.ofString?\"><span class=\"name\">MPN</span>.<span class=\"name\">GNat</span>.<span class=\"name\">ofString?</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">A</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.NatLimbs\">NatLimbs</a> <span class=\"fn\">A</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">(<a href=\"./MPN/Natural.html#MPN.GNat\">GNat</a> <span class=\"fn\">A</span>)</span></span></div></div>","info":{"doc":"The number that a string of decimal digits denotes, like `String.toNat?`.","docLink":"./MPN/Natural.html#MPN.GNat.ofString?","kind":"def","line":804,"name":"MPN.GNat.ofString?","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN/Natural.lean#L804-L808"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Natural.html#MPN.GNat.repr_eq\"><span class=\"name\">MPN</span>.<span class=\"name\">GNat</span>.<span class=\"name\">repr_eq</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">A</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.NatLimbs\">NatLimbs</a> <span class=\"fn\">A</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.GNat\">GNat</a> <span class=\"fn\">A</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./MPN/Natural.html#MPN.GNat.repr\">repr</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./MPN/Natural.html#MPN.GNat.toNat\">toNat</a></span>.<a href=\"./Init/Data/Repr.html#Nat.repr\">repr</a></span></div></div>","info":{"doc":"","docLink":"./MPN/Natural.html#MPN.GNat.repr_eq","kind":"theorem","line":792,"name":"MPN.GNat.repr_eq","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN/Natural.lean#L792-L802"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Natural.html#MPN.GNat.repr\"><span class=\"name\">MPN</span>.<span class=\"name\">GNat</span>.<span class=\"name\">repr</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">A</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.NatLimbs\">NatLimbs</a> <span class=\"fn\">A</span></span>]</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.GNat\">GNat</a> <span class=\"fn\">A</span></span> → <a href=\"./Init/Prelude.html#String\">String</a></span></div></div>","info":{"doc":"The decimal digits, like `Nat.repr`. A word that fits in a `USize` goes to the runtime's\n`USize.repr` directly, without a `Nat` above `2⁶³`, which would be a GMP number.","docLink":"./MPN/Natural.html#MPN.GNat.repr","kind":"def","line":780,"name":"MPN.GNat.repr","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN/Natural.lean#L780-L786"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Natural.html#MPN.GNat.toNat_sqrtNewton\"><span class=\"name\">MPN</span>.<span class=\"name\">GNat</span>.<span class=\"name\">toNat_sqrtNewton</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">A</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.NatLimbs\">NatLimbs</a> <span class=\"fn\">A</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.GNat\">GNat</a> <span class=\"fn\">A</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">n</span>.<a href=\"./MPN/Natural.html#MPN.GNat.sqrtNewton\">sqrtNewton</a></span>.<a href=\"./MPN/Natural.html#MPN.GNat.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">n</span>.<a href=\"./MPN/Natural.html#MPN.GNat.toNat\">toNat</a></span>.<a href=\"./Init/Data/Nat/Sqrt/Basic.html#Nat.sqrt\">sqrt</a></span></div></div>","info":{"doc":"","docLink":"./MPN/Natural.html#MPN.GNat.toNat_sqrtNewton","kind":"theorem","line":755,"name":"MPN.GNat.toNat_sqrtNewton","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN/Natural.lean#L755-L776"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Natural.html#MPN.GNat.sqrtNewton\"><span class=\"name\">MPN</span>.<span class=\"name\">GNat</span>.<span class=\"name\">sqrtNewton</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">A</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.NatLimbs\">NatLimbs</a> <span class=\"fn\">A</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.GNat\">GNat</a> <span class=\"fn\">A</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.GNat\">GNat</a> <span class=\"fn\">A</span></span></div></div>","info":{"doc":"`⌊√n⌋`: from `Nat.sqrt` on words, and above by Newton's iteration at growing precision: the root\n`s` of the top half `n / 4ᵏ`, for `k` about a quarter of the bits of `n`, gives the start\n`(s + 1) 2ᵏ` above `√n` and within `2ᵏ` of it. One Newton step from there is at least `⌊√n⌋`, by\nAM-GM, and at most two above it; `sqrtFix` steps down to `⌊√n⌋` with one square, where checking\nthe step with a second division would cost more.","docLink":"./MPN/Natural.html#MPN.GNat.sqrtNewton","kind":"def","line":731,"name":"MPN.GNat.sqrtNewton","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN/Natural.lean#L731-L753"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Natural.html#MPN.GNat.sqrtFix\"><span class=\"name\">MPN</span>.<span class=\"name\">GNat</span>.<span class=\"name\">sqrtFix</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">A</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.NatLimbs\">NatLimbs</a> <span class=\"fn\">A</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n </span><span class=\"fn\">x </span><span class=\"fn\">sq</span> : <span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.GNat\">GNat</a> <span class=\"fn\">A</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./MPN/Natural.html#MPN.GNat\">GNat</a> <span class=\"fn\">A</span></span></div></div>","info":{"doc":"Steps down from `x ≥ ⌊√n⌋` to `⌊√n⌋`, while `x² > n`, with `sq = x²`: `(x - 1)² = x² - 2 x + 1`\nneeds no product. The guard also checks what the termination needs, which always holds.","docLink":"./MPN/Natural.html#MPN.GNat.sqrtFix","kind":"def","line":687,"name":"MPN.GNat.sqrtFix","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN/Natural.lean#L687-L700"}},{"header":"<div class=\"decl_header\"><span class=