\"><span class=\"fn\">o</span>.<a href=\"./MPN/Generic/Barrett.html#MPN.NatOps.divBlocks\">divBlocks</a></span> <span class=\"fn\">d</span> <span class=\"fn\">μ</span> <span class=\"fn\">n</span> <span class=\"fn\">hn</span> <span class=\"fn\">a</span>)</span></span></div></div>","info":{"doc":"","docLink":"./MPN/Generic/Barrett.html#MPN.NatOps.divBlocks_spec","kind":"theorem","line":677,"name":"MPN.NatOps.divBlocks_spec","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN/Generic/Barrett.lean#L677-L708"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Generic/Barrett.html#MPN.NatOps.divBlocks\"><span class=\"name\">MPN</span>.<span class=\"name\">NatOps</span>.<span class=\"name\">divBlocks</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">o</span> : <span class=\"fn\"><a href=\"./MPN/Generic/Ops.html#MPN.NatOps\">NatOps</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">d </span><span class=\"fn\">μ</span> : <span class=\"fn\">α</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hn</span> : <span class=\"fn\">0</span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\">n</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a</span> : <span class=\"fn\">α</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">α</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span></div></div>