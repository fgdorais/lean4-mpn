 word.","docLink":"./MPN32/Nat.html#MPN.W32.Nat.divRem128L","kind":"def","line":233,"name":"MPN.W32.Nat.divRem128L","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN32/Nat.lean#L233-L253"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN32/Nat.html#MPN.W32.Nat.divRemWord_spec\"><span class=\"name\">MPN</span>.<span class=\"name\">W32</span>.<span class=\"name\">Nat</span>.<span class=\"name\">divRemWord_spec</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a</span> : <a href=\"./ScalarArray/UInt32/Basic.html#ScalarArray.UInt32Array\">ScalarArray.UInt32Array</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">b</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hb</span> : <span class=\"fn\">b</span> <a href=\"./Init/Core.html#Ne\">≠</a> <span class=\"fn\">0</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./MPN32/Basic.html#MPN.W32.toNat\">toNat</a> <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">(<a href=\"./MPN32/Nat.html#MPN.W32.Nat.divRemWord\">divRemWord</a> <span class=\"fn\">a</span> <span class=\"fn\">b</span>)</span>.<a href=\"./Init/Prelude.html#Prod.fst\">fst</a></span>.<a href=\"./ScalarArray/UInt32/Slice.html#ScalarArray.UInt32Array.toSlice\">toSlice</a></span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><a href=\"./MPN32/Basic.html#MPN.W32.toNat\">toNat</a> <span class=\"fn\"><span class=\"fn\">a</span>.<a href=\"./ScalarArray/UInt32/Slice.html#ScalarArray.UInt32Array.toSlice\">toSlice</a></span></span> <a href=\"./Init/Prelude.html#HDiv.hDiv\">/</a> <span class=\"fn\"><span class=\"fn\">b</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toNat\">toNat</a></s