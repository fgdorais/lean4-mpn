ional_types.html\">Type</a>)</span></span> <span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">L</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">LA</span> : <span class=\"fn\"><a href=\"./MPN/LimbArray.html#MPN.LimbArray\">LimbArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">R</span> : <span class=\"fn\"><a href=\"./MPN/WordArray.html#MPN.WordArray\">WordArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">t </span><span class=\"fn\">tu</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a</span> : <span class=\"fn\">A</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ao </span><span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ha</span> : <span class=\"fn\"><a href=\"./MPN/WordArray.html#MPN.WordArray.LoopBound\">LoopBound</a> <span class=\"fn\">a</span> <span class=\"fn\">ao</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">d</span> : <span class=\"fn\">L</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">L</span></div></div>","info":{"doc":"`a % d`, for limbs `ao` to `ao + n - 1` of `a`, like GMP's `mpn_mod_1`: `divRem1W` without the\nquotient (`modLoop`). It requires `0 < d`. From `t` limbs for a normalized `d`, and from `tu` limbs\nfor another, it takes the steps with the reciprocal (`div21`) by the normalized `d 2ˢ`, whose\nremainder `a % d 2ˢ` one more step takes modulo `d`; `a` itself is not shifted. The shift is\nchecked, `s < w` and `(d 2ˢ) / 2ˢ = d`, and so is the last remainder of the steps, as in\n`divRem1W`, with `divStep` when a check fails, so that neither needs a proof.","docLink":"./MPN/Div/ByLimb.html#MPN.WordArray.mod1W","kind":"def","line":962,"name":"MPN.WordArray.mod1W","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Div/ByLimb.lean#L962-L981"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Div/ByLimb.html#MPN.WordArray.divRem1W_spec\"><span class=\"name\">MPN</span>.<span class=\"name\">WordArray</span>.<span class=\"name\">divRem1W_spec</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">A </span><span class=\"fn\">L</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">LA</span> : <span class=\"fn\"><a href=\"./MPN/LimbArray.html#MPN.LimbArray\">LimbArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">R</span> : <span class=\"fn\"><a href=\"./MPN/WordArray.html#MPN.WordArray\">WordArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">t </span><span class=\"fn\">tu</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">r</span> : <span class=\"fn\">A</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ro</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\">