296f1cf7ff688fd89/MPN/Div/ByLimb.lean#L901-L918"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Div/ByLimb.html#MPN.WordArray.divRem1W\"><span class=\"name\">MPN</span>.<span class=\"name\">WordArray</span>.<span class=\"name\">divRem1W</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <a href=\"./foundational_types.html\">Type</a>)</span></span> <span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">L</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">LA</span> : <span class=\"fn\"><a href=\"./MPN/LimbArray.html#MPN.LimbArray\">LimbArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">R</span> : <span class=\"fn\"><a href=\"./MPN/WordArray.html#MPN.WordArray\">WordArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">t </span><span class=\"fn\">tu</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">r</span> : <span class=\"fn\">A</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ro</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a</span> : <span class=\"fn\">A</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ao </span><span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hr</span> : <span class=\"fn\"><a href=\"./MPN/WordArray.html#MPN.WordArray.LoopBound\">LoopBound</a> <span class=\"fn\">r</span> <span class=\"fn\">ro</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ha</span> : <span class=\"fn\"><a href=\"./MPN/WordArray.html#MPN.WordArray.LoopBound\">LoopBound</a> <span class=\"fn\">a</span> <span class=\"fn\">ao</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">d</span> : <span class=\"fn\">L</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">A</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">L</span></div></div>","info":{"doc":"Writes the limbs of `a / d`, for limbs `ao` to `ao + n - 1` of `a`, into limbs `ro` to `ro + n - 1`\nof `r` and returns `a % d`, like GMP's `mpn_divrem_1`. It requires `0 < d`. From `t` limbs and for\na normalized `d` it takes the steps with the reciprocal (`div21`), which then pays for its division;\nif their remainder is not below `d`, a check failed, and it divides again by `div2Rem`, into the\narray of the first pass. From `tu` limbs and for an unnormalized `d` it takes the same steps on\n`a 2ˢ` and `d 2ˢ` (`divRem1U`).","docLink":"./MPN/Div/ByLimb.html#MPN.WordArray.divRem1W","kind":"def","line":815,"name":"MPN.WordArray.divRem1W","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Div/ByLimb.lean#L815-L830"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Div/ByLimb.html#MPN.WordArray.divRem1U\"><span class=\"name\">MPN</span>.<span class=\"name\">WordArray</span>.<span class=\"name\">divRem1U</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <a href=\"./foundational_types.html\">Type</a>)</span></span> <span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">L</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">LA</span> : <span class=\"fn\"><a href=\"./MPN/LimbArray.html#MPN.LimbArray\">LimbArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">R</span> : <span class=\"fn\"><a href=\"./MPN/WordArray.html#MPN.WordArray\">WordArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">r</span> : <span class=\"fn\">A</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ro</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a</span> : <span class=\"fn\">A</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ao </span><span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hr</span> : <span class=\"fn\"><a href=\"./MPN/WordArray.html#MPN.WordArray.LoopBound\">LoopBound</a> <span class=\"fn\">r</span> <span class=\"fn\">ro</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ha</span> : <span class=\"fn\"><a href=\"./MPN/WordArray.html#MPN.WordArray.LoopBound\">LoopBound</a> <span class=\"fn\">a</span> <span class=\"fn\">ao</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">d</span> : <span class=\"fn\">L</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">A</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">L</span></div></div>","info":{"doc":"`a / d` and `a % d` like `divRem1W`, for an unnormalized `d`, by the steps with the reciprocal of\n`d 2ˢ`, normalized, on `a 2ˢ`, like GMP's `mpn_divrem_1`: `divLoopSh` forms each limb of `a 2ˢ`\nfrom two limbs of `a` as it goes, from the top bits of `a` as the first remainder, and the\nremainder is shifted back. The shift is checked, `0 < s < w` and `(d 2ˢ) / 2ˢ = d`, and so is the\nremainder of the steps, with `div2Rem` when a check fails, so that neither needs a proof.","docLink":"./MPN/Div/ByLimb.html#MPN.WordArray.divRem1U","kind":"def","line":793,"name":"MPN.WordArray.divRem1U","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Div/ByLimb.lean#L793-L812"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Div/ByLimb.html#MPN.WordArray.normShift\"><span class=\"name\">MPN</span>.<span class=\"name\">WordArray</span>.<span class=\"name\">normShift</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <a href=\"./foundational_types.html\">Type</a>)</span></span> <span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">L</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">LA</span> : <span class=\"fn\"><a href=\"./MPN/LimbArray.html#MPN.LimbArray\">LimbArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">R</span> : <span class=\"fn\"><a href=\"./MPN/WordArray.html#MPN.WordArray\">WordArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">d</span> : <span class=\"fn\">L</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">L</span></div></div>","info":{"doc":"The shift `w - 1 - ⌊log₂ d⌋` that normalizes a nonzero `d`.","docLink":"./MPN/Div/ByLimb.html#MPN.WordArray.normShift","kind":"def","line":789,"name":"MPN.WordArray.normShift","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Div/ByLimb.lean#L789-L790"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Div/ByLimb.html#MPN.WordArray.divLoopSh_spec\"><span class=\"name\">MPN</span>.<span class=\"name\">WordArray</span>.<span class=\"name\">divLoopSh_spec</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">A </span><span class=\"fn\">L</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">LA</span> : <span class=\"fn\"><a href=\"./MPN/LimbArray.html#MPN.LimbArray\">LimbArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\">R</span> : <span class=\"fn\"><a href=\"./MPN/WordArray.html#MPN.WordArray\">WordArray</a> <span class=\"fn\">A</span> <span class=\"fn\">L</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">step</span> : <span class=\"fn\"><span class=\"fn\">L</span> → <span class=\"fn\">L</span> → <span class=\"fn\">L</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">L</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">d</span> : <span class=\"fn\">L</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hs</span> :