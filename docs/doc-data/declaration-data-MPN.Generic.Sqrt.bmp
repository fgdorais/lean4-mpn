split3","kind":"theorem","line":146,"name":"MPN.split3","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Generic/Sqrt.lean#L146-L156"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Generic/Sqrt.html#MPN.karatsuba_sqrt\"><span class=\"name\">MPN</span>.<span class=\"name\">karatsuba_sqrt</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">B </span><span class=\"fn\">N' </span><span class=\"fn\">a₁ </span><span class=\"fn\">a₀ </span><span class=\"fn\">t </span><span class=\"fn\">q </span><span class=\"fn\">u</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ht</span> : <span class=\"fn\">t</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><span class=\"fn\">N'</span>.<a href=\"./Init/Data/Nat/Sqrt/Basic.html#Nat.sqrt\">sqrt</a></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ha₁</span> : <span class=\"fn\">a₁</span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\">B</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ha₀</span> : <span class=\"fn\">a₀</span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\">B</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hs</span> : <span class=\"fn\">B</span> <a href=\"./Init/Prelude.html#LE.le\">≤</a> <span class=\"fn\">2</span> <a href=\"./Init/Prelude.html#HMul.hMul\">*</a> <span class=\"fn\">t</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hq</span> : <span class=\"fn\">q</span> <a href=\"./Init/Prelude.html#Eq\">=</a> ((<span class=\"fn\">N'</span> <a href=\"./Init/Prelude.html#HSub.hSub\">-</a> <span class=\"fn\">t</span> <a href=\".