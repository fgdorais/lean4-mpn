ub.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN32/Arch/UInt.lean#L185-L194"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN32/Arch/UInt.html#UInt32.addWithCarry_spec\"><span class=\"name\">UInt32</span>.<span class=\"name\">addWithCarry_spec</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x </span><span class=\"fn\">y</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./MPN32/Arch/UInt.html#UInt32.addWithCarry\">addWithCarry</a></span> <span class=\"fn\">y</span> <span class=\"fn\">c</span>)</span>.<a href=\"./Init/Prelude.html#Prod.fst\">fst</a></span>.<a href=\"./Init/Prelude.html#UInt32.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./MPN32/Arch/UInt.html#UInt32.addWithCarry\">addWithCarry</a></span> <span class=\"fn\">y</span> <span class=\"fn\">c</span>)</span>.<a href=\"./Init/Prelude.html#Prod.snd\">snd</a></span>.<a href=\"./Init/Data/Bool.html#Bool.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HMul.hMul\">*</a> <span class=\"fn\">2</span> <a href=\"./Init/Prelude.html#HPow.hPow\">^</a> <span class=\"fn\">32</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./Init/Prelude.html#UInt32.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\"><span class=\"fn\">y</span>.<a href=\"./Init/Prelude.html#UInt32.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\"><span class=\"fn\">c</span>.<a href=\"./Init/Data/Bool.html#Bool.toNat\">toNat</a></span></div></div>","info":{"doc":"","docLink":"./MPN32/Arch/UInt.html#UInt32.addWithCarry_spec","kind":"theorem","line":177,"name":"UInt32.addWithCarry_spec","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN32/Arch/UInt.lean#L177-L183"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN32/Arch/UInt.html#UInt32.toUInt32_sub\"><span class=\"name\">UInt32</span>.<span class=\"name\">toUInt32_sub</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">p</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">b</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">p</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toUInt32\">toUInt32</a></span> <a href=\"./Init/Prelude.html#HSub.hSub\">-</a> <span class=\"fn\">b</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">(<span class=\"fn\">p</span> <a href=\"./Init/Prelude.html#HSub.hSub\">-</a> <span class=\"fn\"><span class=\"fn\">b</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt32.toUInt64\">toUInt64</a></span>).<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toUInt32\">toUInt32</a></span></div></div>","info":{"doc":"The low word of `p - b` from the low word of `p`, as in `toUInt32_add`.","docLink":"./MPN32/Arch/UInt.html#UInt32.toUInt32_sub","kind":"theorem","line":168,"name":"UInt32.toUInt32_sub","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN32/Arch/UInt.lean#L168-L175"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN32/Arch/UInt.html#UInt32.toUInt32_add\"><span class=\"name\">UInt32</span>.<span class=\"name\">toUInt32_add</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">p</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">p</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toUInt32\">toUInt32</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\">h</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">(<span class=\"fn\">p</span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\"><span class=\"fn\">h</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt32.toUInt64\">toUInt64</a></span>).<a href=\"./Init/Data/UInt/BasicAux.html#UInt64.toUInt32\">toUInt32</a></span></div></div>","info":{"doc":"The low word of `p + h` from the low word of `p`. The steps of the compiled loops compute their low\nword this way, as `lo p + h` with the carry `h`, and their carry from `p + h`: using `p` twice keeps\nLLVM from adding the carry first, which would put the rest of the step on its dependency chain.","docLink":"./MPN32/Arch/UInt.html#UInt32.toUInt32_add","kind":"theorem","line":156,"name":"UInt32.toUInt32_add","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN32/Arch/UInt.lean#L156-L166"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN32/Arch/UInt.html#UInt32.mulAddAdd\"><span class=\"name\">UInt32</span>.<span class=\"name\">mulAddAdd</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x </span><span class=\"fn\">y </span><span class=\"fn\">a </span><span class=\"fn\">b</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#UInt32\">UInt32</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Init/Prelude.html#UInt32\">UInt32</a></div></div>","info":{"doc":"`x * y + a + b` as its low word and its high word. In a loop, `b` is the carry, and it joins last,\nafter `p = x y + a`, which is also used for the low word: with `x y + a + b` written as one sum,\nLLVM adds the carry first, which puts the multiplication on the carry's dependency chain (on\nAArch64 the multiply-accumulate `umaddl`, a chain of about 5 cycles per limb, against 2 here).","docLink":"./MPN32/Arch/UInt.html#UInt32.mulAddAdd","kind":"def","line":142,"name":"UInt32.mulAddAdd","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN32/Arch/UInt.lean#L142-L150"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN32/Arch/UInt.html#UInt32.subWithBorrow\"><span class=\"name\">UInt32</span>.<span class=\"name\">subWithBorrow</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x </span><span class=\"fn\">y</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">b</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#UInt32\">UInt32</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"`x - y - b` as its low word, wrapping, and a borrow out.","docLink":"./MPN32/Arch/UInt.html#UInt32.subWithBorrow","kind":"def","line":137,"name":"UInt32.subWithBorrow","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN32/Arch/UInt.lean#L137-L140"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN32/Arch/UInt.html#UInt32.addWithCarry\"><span class=\"name\">UInt32</span>.<span class=\"name\">addWithCarry</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x </span><span class=\"fn\">y</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#UInt32\">UInt32</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"`x + y + c` as its low word and a carry out.","docLink":"./MPN32/Arch/UInt.html#UInt32.addWithCarry","kind":"def","line":132,"name":"UInt32.addWithCarry","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN32/Arch/UInt.lean#L132-L135"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN32/Arch/UInt.html#UInt16.mulAddAdd_spec\"><span class=\"name\">UInt16</span>.<span class=\"name\">mulAddAdd_spec</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x </span><span class=\"fn\">y </span><span class=\"fn\">a </span><span class=\"fn\">b</span> : <a href=\"./Init/Prelude.html#UInt16\">UInt16</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./MPN32/Arch/UInt.html#UInt16.mulAddAdd\">mulAddAdd</a></span> <span class=\"fn\">y</span> <span class=\"fn\">a</span> <span class=\"fn\">b</span>)</span>.<a href=\"./Init/Prelude.html#Prod.fst\">fst</a></span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt16.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./MPN32/Arch/UInt.html#UInt16.mulAddAdd\">mulAddAdd</a></span> <span class=\"fn\">y</span> <span class=\"fn\">a</span> <span class=\"fn\">b</span>)</span>.<a href=\"./Init/Prelude.html#Prod.snd\">snd</a></span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt16.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HMul.hMul\">*</a> <span class=\"fn\">2</span> <a href=\"./Init/Prelude.html#HPow.hPow\">^</a> <span class=\"fn\">16</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt16.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HMul.hMul\">*</a> <span class=\"fn\"><span class=\"fn\">y</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt16.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\"><span class=\"fn\">a</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt16.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\"><span class=\"fn\">b</span>.<a href=\"./Init/Data/UInt/BasicAux.html#UInt16.toNat\">toNat</a></span></div></div>","info":{"doc":"","docLink":"./MPN32/Arch/UInt.html#UInt16.mulAddAdd_spec","kind":"theorem","line":116,"name":"UInt16.mulAddAdd_spec","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/0c3e72656c98060de12dca90ae58fec3c9765095/MPN32/Arch/UInt.lean#L116-L128"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN32/Arch/UInt.html#UInt16.subWithBorrow_spec\"><span class=\"name\">UInt16</span>.<span class=\"name\">subWithBorrow_spec</span></a> </span><span class=\"decl_args\"><sp