\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">U </span><span class=\"fn\">V</span> : <span class=\"fn\">α</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n </span><span class=\"fn\">k</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">α</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span></div></div>","info":{"doc":"`(U / V, U % V)` for `0 < V < Bⁿ` and `U < V Bᵏ`: one digit of `s ≤ ⌊n / 2⌋` limbs from the top,\nestimated by a recursive division and corrected by `dcFix`, then the rest recursively; `base`\nbelow `T` limbs.","docLink":"./MPN/Generic/DC.html#MPN.NatOps.divNorm","kind":"def","line":129,"name":"MPN.NatOps.divNorm","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Generic/DC.lean#L129-L153"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Generic/DC.html#MPN.NatOps.dcDigit\"><span class=\"name\">MPN</span>.<span class=\"name\">NatOps</span>.<span class=\"name\">dcDigit</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">k </span><span class=\"fn\">m</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Nat\">Nat</a></div></div>","info":{"doc":"The size of the top digit: `k mod m`, or `m` when `m` divides `k`.","docLink":"./MPN/Generic/DC.html#MPN.NatOps.dcDigit","kind":"def","line":108,"name":"MPN.NatOps.dcDigit","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Generic/DC.lean#L108-L109"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Generic/DC.html#MPN.NatOps.dcFix\"><span class=\"name\">MPN</span>.<span class=\"name\">NatOps</span>.<span class=\"name\">dcFix</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">o</span> : <span class=\"fn\"><a href=\"./MPN/Generic/Ops.html#MPN.NatOps\">NatOps</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">V </span><span class=\"fn\">P </span><span class=\"fn\">Q </span><span class=\"fn\">T</span> : <span class=\"fn\">α</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">α</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">α</span></div></div>","info":{"doc":"Adds `V` to `T` and decreases `Q` while `T < P`: with the invariant `T + Q V = W + P`, it ends\nwith `Q = ⌊W / V⌋` and `T = W mod V + P`.","docLink":"./MPN/Generic/DC.html#MPN.NatOps.dcFix","kind":"def","line":45,"name":"MPN.NatOps.dcFix","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Generic/DC.lean#L45-L58"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./MPN/Generic/DC.html#MPN.NatOps.val_allOnes\"><span class=\"name\">MPN</span>.<span class=\"name\">NatOps</span>.<span class=\"name\">val_allOnes</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">o</span> : <span class=\"fn\"><a href=\"./MPN/Generic/Ops.html#MPN.NatOps\">NatOps</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args