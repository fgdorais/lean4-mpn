PN/Generic/DC.html#MPN.NatOps.allOnes","kind":"def","line":35,"name":"MPN.NatOps.allOnes","sourceLink":"https://github.com/fgdorais/lean4-mpn/blob/862f63d87fc6e56d648eb33296f1cf7ff688fd89/MPN/Generic/DC.lean#L35-L36"}}],"imports":["Init","MPN.Generic.Ops"],"instances":[],"name":"MPN.Generic.DC"}