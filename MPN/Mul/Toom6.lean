module

public import MPN.Mul.Toom4

/-!
# Toom-6

Toom-6 splits both operands in six parts at `x = βᵏ`, so that their product is the value at `x`
of a polynomial of degree ten, recovered from eleven products of about a sixth of the size: the
values at `0, 1, …, 9, ∞`. As in `Mul.Toom4`, the points are natural numbers and the
interpolation divides the values by their points, takes differences at `1, …, 9` and brings the
Newton form back with Horner's rule; each intermediate value is a natural number and each division
exact. The differences are not divided along the way: level `l` holds `l!` times the divided
differences, and only its first entry, the one Horner's rule needs, is divided by `l!`, which
makes eight divisions instead of thirty-six (an odd one costs three subtractions). The
interpolation is long (about ninety passes), and its definition and proof are generated by
`scripts/toom_interp.py` from the exact value of each intermediate.
-/

open ScalarArray

namespace MPN

/-! ## Evaluation -/

/-- `acc + p (x₀ + j x₁ + j² x₂ + ⋯)`, one pass of `addMulVal` per part. -/
public def evalGo (j : Nat) : UInt32Array → List UInt32Array.Slice → Nat → UInt32Array
  | acc, [], _ => acc
  | acc, x :: xs, p => evalGo j (addMulVal acc x p.toUInt32) xs (p * j)

/-- The value at `j` of the polynomial whose coefficients are the parts `xs`, with room for it. -/
public def evalPoly (xs : List UInt32Array.Slice) (j : Nat) : UInt32Array :=
  evalGo j (.replicate (xs.foldr (fun x m => max x.size m) 0 + 1) 0) xs 1

public theorem size_evalGo (j : Nat) (acc : UInt32Array) (xs : List UInt32Array.Slice) (p : Nat) :
    (evalGo j acc xs p).size = acc.size := by
  induction xs generalizing acc p with
  | nil => rfl
  | cons x xs ih => rw [evalGo, ih, size_addMulVal]

public theorem size_evalPoly (xs : List UInt32Array.Slice) (j : Nat) :
    (evalPoly xs j).size = xs.foldr (fun x m => max x.size m) 0 + 1 := by
  rw [evalPoly, size_evalGo]; simp

/-- Each part is at most the largest. -/
private theorem le_foldr_max (xs : List UInt32Array.Slice) :
    ∀ x ∈ xs, x.size ≤ xs.foldr (fun x m => max x.size m) 0 := by
  induction xs with
  | nil => simp
  | cons y ys ih =>
    intro x hx
    simp only [List.mem_cons] at hx
    simp only [List.foldr_cons]
    rcases hx with rfl | hx
    · exact Nat.le_max_left _ _
    · exact Nat.le_trans (ih x hx) (Nat.le_max_right _ _)

public theorem toNat_evalGo (j : Nat) (acc : UInt32Array) (xs : List UInt32Array.Slice) (p : Nat)
    (hs : ∀ x ∈ xs, x.size < acc.size) (hp : ∀ i < xs.length, p * j ^ i < 2 ^ 32)
    (hlt : toNat acc + p * polyVal j (xs.map fun x => toNat x) < 2 ^ (32 * acc.size)) :
    toNat (evalGo j acc xs p) = toNat acc + p * polyVal j (xs.map fun x => toNat x) := by
  induction xs generalizing acc p with
  | nil => simp [evalGo, polyVal]
  | cons x xs ih =>
    have hp0 := hp 0 (by simp)
    simp only [Nat.pow_zero, Nat.mul_one] at hp0
    have hpt : (p.toUInt32).toNat = p := by
      simp only [Nat.toUInt32_eq, UInt32.toNat_ofNat']; exact Nat.mod_eq_of_lt hp0
    simp only [List.map_cons, polyVal] at hlt ⊢
    have h₁ : toNat acc + toNat x * p < 2 ^ (32 * acc.size) := by
      have : toNat x * p ≤ p * (toNat x + j * polyVal j (xs.map fun x => toNat x)) := by
        rw [Nat.mul_comm (toNat x)]; exact Nat.mul_le_mul_left _ (Nat.le_add_right _ _)
      lia
    have hv := toNat_addMulVal acc x p.toUInt32 (hs x (by simp)) (by rw [hpt]; exact h₁)
    rw [hpt] at hv
    rw [evalGo, ih _ _ (fun y hy => by rw [size_addMulVal]; exact hs y (by simp [hy]))
      (fun i hi => by
        have h := hp (i + 1) (by simp; lia)
        rw [Nat.pow_succ] at h
        rw [Nat.mul_assoc, Nat.mul_comm j]
        exact h)
      (by rw [hv, size_addMulVal, Nat.mul_assoc]
          rw [Nat.mul_add] at hlt
          rw [Nat.mul_comm (toNat x)]; lia), hv]
    rw [Nat.mul_add, Nat.mul_comm (toNat x), Nat.mul_assoc]
    lia

/-- With coefficients at most `B`, the value is at most `B` times the value of ones. -/
private theorem polyVal_le (j B : Nat) (l : List Nat) (h : ∀ c ∈ l, c ≤ B) :
    polyVal j l ≤ B * polyVal j (List.replicate l.length 1) := by
  induction l with
  | nil => simp [polyVal]
  | cons c l ih =>
    simp only [polyVal, List.length_cons, List.replicate_succ]
    have h₁ := h c (by simp)
    have h₂ := Nat.mul_le_mul_left j (ih fun c hc => h c (by simp [hc]))
    rw [Nat.mul_add, Nat.mul_one, Nat.mul_left_comm]
    lia

public theorem toNat_evalPoly (xs : List UInt32Array.Slice) (j : Nat)
    (hp : ∀ i < xs.length, j ^ i < 2 ^ 32)
    (hS : polyVal j (List.replicate xs.length 1) ≤ 2 ^ 32) :
    toNat (evalPoly xs j) = polyVal j (xs.map fun x => toNat x) := by
  generalize hm : xs.foldr (fun x m => max x.size m) 0 = m
  have hz := toNat_zeros (m + 1)
  have hle := le_foldr_max xs
  rw [hm] at hle
  -- Each part is below `βᵐ`, so the value is below `βᵐ⁺¹`.
  have hB : ∀ c ∈ xs.map (fun x => toNat x), c ≤ 2 ^ (32 * m) - 1 := by
    intro c hc
    obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hc
    have := toNat_lt x
    have : 2 ^ (32 * x.size) ≤ 2 ^ (32 * m) := Nat.pow_le_pow_right (by decide) (by
      have := hle x hx; lia)
    lia
  have hv := polyVal_le j _ _ hB
  rw [List.length_map] at hv
  have hlt : polyVal j (xs.map fun x => toNat x) < 2 ^ (32 * (m + 1)) := by
    have hpow : 2 ^ (32 * (m + 1)) = 2 ^ (32 * m) * 2 ^ 32 := by rw [← Nat.pow_add]; congr 1
    have hP := Nat.two_pow_pos (32 * m)
    have := Nat.mul_le_mul_left (2 ^ (32 * m) - 1) hS
    have : (2 ^ (32 * m) - 1) * 2 ^ 32 < 2 ^ (32 * m) * 2 ^ 32 :=
      Nat.mul_lt_mul_of_pos_right (by lia) (by decide)
    lia
  rw [evalPoly, hm, toNat_evalGo j _ xs 1 (fun x hx => by simp; have := hle x hx; lia)
    (fun i hi => by rw [Nat.one_mul]; exact hp i hi) (by rw [hz]; simpa using hlt), hz]
  simp

