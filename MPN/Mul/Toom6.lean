  have hq₁_₂ : toNat q₁_₂ = C₄ + C₅ + C₆ + C₇ + C₈ + C₉ := toNat_hStep q₂_₁ q₂_₂ 2 _ _ (C₄ +
      C₅ + C₆ + C₇ + C₈ + C₉) hq₂_₁ hq₂_₂
    (by simp only [UInt32.reduceToNat]; lia)
  have hq₁_₃ : toNat q₁_₃ = C₅ + C₆ + C₇ + C₈ + C₉ := toNat_hStep q₂_₂ q₂_₃ 2 _ _ (C₅ + C₆ +
      C₇ + C₈ + C₉) hq₂_₂ hq₂_₃
    (by simp only [UInt32.reduceToNat]; lia)
  have hq₁_₄ : toNat q₁_₄ = C₆ + C₇ + C₈ + C₉ := toNat_hStep q₂_₃ q₂_₄ 2 _ _ (C₆ + C₇ + C₈ +
      C₉) hq₂_₃ hq₂_₄
    (by simp only [UInt32.reduceToNat]; lia)
  have hq₁_₅ : toNat q₁_₅ = C₇ + C₈ + C₉ := toNat_hStep q₂_₄ q₂_₅ 2 _ _ (C₇ + C₈ + C₉) hq₂_₄ hq₂_₅
    (by simp only [UInt32.reduceToNat]; lia)
  have hq₁_₆ : toNat q₁_₆ = C₈ + C₉ := toNat_hStep q₂_₅ d₈ 2 _ _ (C₈ + C₉) hq₂_₅ hd₈
    (by simp only [UInt32.reduceToNat]; lia)
  have hq₀_₀ : toNat q₀_₀ = C₁ := toNat_sStep r₁ q₁_₀ _ _ (C₁) hr₁ hq₁_₀ (by lia)
  have hq₀_₁ : toNat q₀_₁ = C₂ := toNat_sStep q₁_₀ q₁_₁ _ _ (C₂) hq₁_₀ hq₁_₁ (by lia)
  have hq₀_₂ : toNat q₀_₂ = C₃ := toNat_sStep q₁_₁ q₁_₂ _ _ (C₃) hq₁_₁ hq₁_₂ (by lia)
  have hq₀_₃ : toNat q₀_₃ = C₄ := toNat_sStep q₁_₂ q₁_₃ _ _ (C₄) hq₁_₂ hq₁_₃ (by lia)
  have hq₀_₄ : toNat q₀_₄ = C₅ := toNat_sStep q₁_₃ q₁_₄ _ _ (C₅) hq₁_₃ hq₁_₄ (by lia)
  have hq₀_₅ : toNat q₀_₅ = C₆ := toNat_sStep q₁_₄ q₁_₅ _ _ (C₆) hq₁_₄ hq₁_₅ (by lia)
  have hq₀_₆ : toNat q₀_₆ = C₇ := toNat_sStep q₁_₅ q₁_₆ _ _ (C₇) hq₁_₅ hq₁_₆ (by lia)
  have hq₀_₇ : toNat q₀_₇ = C₈ := toNat_sStep q₁_₆ d₈ _ _ (C₈) hq₁_₆ hd₈ (by lia)
  simp only [List.map_cons, List.map_nil, h₀, h₁₀, hq₀_₀, hq₀_₁, hq₀_₂, hq₀_₃, hq₀_₄, hq₀_₅,
      hq₀_₆, hq₀_₇, hd₈]

/-! ## Products -/

/-- The six parts of `s` at `k` limbs: five of `k` limbs and the rest. -/
def parts6 (s : UInt32Array.Slice) (k : Nat) : List UInt32Array.Slice :=
  [s.slice 0 k, s.slice k (2 * k), s.slice (2 * k) (3 * k), s.slice (3 * k) (4 * k),
    s.slice (4 * k) (5 * k), s.slice (5 * k) s.size]

private theorem toNat_parts6 (s : UInt32Array.Slice) (k : Nat) :
    toNat s = polyVal (2 ^ (32 * k)) ((parts6 s k).map fun x => toNat x) := by
  have e₁ := toNat_slice_split s 0 k
  have e₂ := toNat_slice_split s k k
  have e₃ := toNat_slice_split s (2 * k) k
  have e₄ := toNat_slice_split s (3 * k) k
  have e₅ := toNat_slice_split s (4 * k) k
  rw [show k + k = 2 * k by lia] at e₂
  rw [show 2 * k + k = 3 * k by lia] at e₃
  rw [show 3 * k + k = 4 * k by lia] at e₄
  rw [show 4 * k + k = 5 * k by lia] at e₅
  rw [Nat.zero_add] at e₁
  have e₀ : toNat (s.slice 0 s.size) = toNat s := by rw [toNat_slice_from s 0 (by lia)]; simp
  rw [← e₀, e₁, e₂, e₃, e₄, e₅]
  simp [parts6, polyVal]

private theorem size_evalPoly_parts6 (s : UInt32Array.Slice) (k j : Nat) :
    (evalPoly (parts6 s k) j).size ≤ max k (s.size - 5 * k) + 1 := by
  rw [size_evalPoly]
  simp only [parts6, List.foldr_cons, List.foldr_nil, UInt32Array.Slice.size_slice, Nat.min_self]
  refine Nat.add_le_add_right ?_ _
  simp only [Nat.max_le]
  and_intros <;> lia

/-- The product of two polynomials of degree five: its first and last coefficients. -/
private theorem polyMul_six (A₀ A₁ A₂ A₃ A₄ A₅ B₀ B₁ B₂ B₃ B₄ B₅ : Nat) :
    ∃ C₁ C₂ C₃ C₄ C₅ C₆ C₇ C₈ C₉, polyMul [A₀, A₁, A₂, A₃, A₄, A₅] [B₀, B₁, B₂, B₃, B₄, B₅] =
      [A₀ * B₀, C₁, C₂, C₃, C₄, C₅, C₆, C₇, C₈, C₉, A₅ * B₅] := by
  simp only [polyMul, polyAdd, List.map_cons, List.map_nil, Nat.add_zero]
  exact ⟨_, _, _, _, _, _, _, _, _, rfl⟩

/--
The product `a * b` by one step of Toom-6, splitting both in six at `k` limbs, for `1 ≤ k`,
`5 k ≤ b.size ≤ a.size`. It computes the eleven products with `mulRec`, which only receives
inputs smaller than `a` and `b` together.
-/
public def toom6At (a b : UInt32Array.Slice) (k : Nat) (hk : 1 ≤ k) (hkb : 5 * k ≤ b.size)
    (hab : b.size ≤ a.size)
    (mulRec : (x y : UInt32Array.Slice) → x.size + y.size < a.size + b.size → UInt32Array) :
    UInt32Array :=
  let w (j : Nat) := mulRec (evalPoly (parts6 a k) j) (evalPoly (parts6 b k) j) (by
    have := size_evalPoly_parts6 a k j
    have := size_evalPoly_parts6 b k j
    simp only [UInt32Array.size_toSlice]; lia)
  let c₀ := mulRec (a.slice 0 k) (b.slice 0 k) (by simp only [UInt32Array.Slice.size_slice]; lia)
  let c₁₀ := mulRec (a.slice (5 * k) a.size) (b.slice (5 * k) b.size)
    (by simp only [UInt32Array.Slice.size_slice]; lia)
  assembleFrom (.replicate (a.size + b.size) 0) 0 k
    (toom6Interp c₀ (w 1) (w 2) (w 3) (w 4) (w 5) (w 6) (w 7) (w 8) (w 9) c₁₀)

public theorem toom6At_spec (a b : UInt32Array.Slice) (k : Nat) (hk : 1 ≤ k)
    (hkb : 5 * k ≤ b.size) (hab : b.size ≤ a.size)
    (mulRec : (x y : UInt32Array.Slice) → x.size + y.size < a.size + b.size → UInt32Array)
    (hrec : ∀ x y h, (mulRec x y h).size = x.size + y.size ∧
      toNat (mulRec x y h) = toNat x * toNat y) :
    (toom6At a b k hk hkb hab mulRec).size = a.size + b.size ∧
      toNat (toom6At a b k hk hkb hab mulRec) = toNat a * toNat b := by
  have ha := toNat_parts6 a k
  have hb := toNat_parts6 b k
  have hlt : toNat a * toNat b < 2 ^ (32 * (a.size + b.size)) := by
    rw [Nat.mul_add, Nat.pow_add]
    exact Nat.mul_lt_mul'' (toNat_lt a) (toNat_lt b)
  -- The values at `j` are the products of the values of the parts.
  have hw : ∀ j, (∀ i < 6, j ^ i < 2 ^ 32) → polyVal j (List.replicate 6 1) ≤ 2 ^ 32 → ∀ h,
      toNat (mulRec (evalPoly (parts6 a k) j) (evalPoly (parts6 b k) j) h) =
        polyVal j (polyMul ((parts6 a k).map fun x => toNat x)
          ((parts6 b k).map fun x => toNat x)) := fun j hp hS h => by
    rw [(hrec _ _ h).2, polyVal_polyMul,
      toNat_evalPoly _ _ (by simpa [parts6] using hp) (by simpa [parts6] using hS),
      toNat_evalPoly _ _ (by simpa [parts6] using hp) (by simpa [parts6] using hS)]
  obtain ⟨-, hv₀⟩ := hrec (a.slice 0 k) (b.slice 0 k)
    (by simp only [UInt32Array.Slice.size_slice]; lia)
  obtain ⟨-, hv₁₀⟩ := hrec (a.slice (5 * k) a.size) (b.slice (5 * k) b.size)
    (by simp only [UInt32Array.Slice.size_slice]; lia)
  simp only [toom6At]
  generalize hW₁ : mulRec (evalPoly (parts6 a k) 1) _ _ = w₁
  generalize hW₂ : mulRec (evalPoly (parts6 a k) 2) _ _ = w₂
  generalize hW₃ : mulRec (evalPoly (parts6 a k) 3) _ _ = w₃
  generalize hW₄ : mulRec (evalPoly (parts6 a k) 4) _ _ = w₄
  generalize hW₅ : mulRec (evalPoly (parts6 a k) 5) _ _ = w₅
  generalize hW₆ : mulRec (evalPoly (parts6 a k) 6) _ _ = w₆
  generalize hW₇ : mulRec (evalPoly (parts6 a k) 7) _ _ = w₇
  generalize hW₈ : mulRec (evalPoly (parts6 a k) 8) _ _ = w₈
  generalize hW₉ : mulRec (evalPoly (parts6 a k) 9) _ _ = w₉
  have hw₁ := hW₁ ▸ hw 1 (by decide) (by decide) _
  have hw₂ := hW₂ ▸ hw 2 (by decide) (by decide) _
  have hw₃ := hW₃ ▸ hw 3 (by decide) (by decide) _
  have hw₄ := hW₄ ▸ hw 4 (by decide) (by decide) _
  have hw₅ := hW₅ ▸ hw 5 (by decide) (by decide) _
  have hw₆ := hW₆ ▸ hw 6 (by decide) (by decide) _
  have hw₇ := hW₇ ▸ hw 7 (by decide) (by decide) _
  have hw₈ := hW₈ ▸ hw 8 (by decide) (by decide) _
  have hw₉ := hW₉ ▸ hw 9 (by decide) (by decide) _
  clear hw hW₁ hW₂ hW₃ hW₄ hW₅ hW₆ hW₇ hW₈ hW₉
  generalize mulRec (a.slice 0 k) _ _ = c₀ at *
  generalize mulRec (a.slice (5 * k) a.size) _ _ = c₁₀ at *
  simp only [parts6, List.map_cons, List.map_nil] at ha hb hw₁ hw₂ hw₃ hw₄ hw₅ hw₆ hw₇ hw₈ hw₉
  obtain ⟨C₁, C₂, C₃, C₄, C₅, C₆, C₇, C₈, C₉, hC⟩ := polyMul_six (toNat (a.slice 0 k))
    (toNat (a.slice k (2 * k))) (toNat (a.slice (2 * k) (3 * k))) (toNat (a.slice (3 * k) (4 * k)))
    (toNat (a.slice (4 * k) (5 * k))) (toNat (a.slice (5 * k) a.size)) (toNat (b.slice 0 k))
    (toNat (b.slice k (2 * k))) (toNat (b.slice (2 * k) (3 * k))) (toNat (b.slice (3 * k) (4 * k)))
    (toNat (b.slice (4 * k) (5 * k))) (toNat (b.slice (5 * k) b.size))
  rw [hC] at hw₁ hw₂ hw₃ hw₄ hw₅ hw₆ hw₇ hw₈ hw₉
  have hab' : toNat a * toNat b = polyVal (2 ^ (32 * k))
      [toNat (a.slice 0 k) * toNat (b.slice 0 k), C₁, C₂, C₃, C₄, C₅, C₆, C₇, C₈, C₉,
        toNat (a.slice (5 * k) a.size) * toNat (b.slice (5 * k) b.size)] := by
    rw [ha, hb, ← polyVal_polyMul, hC]
  generalize toNat (a.slice 0 k) * toNat (b.slice 0 k) = C₀ at *
  generalize toNat (a.slice (5 * k) a.size) * toNat (b.slice (5 * k) b.size) = C₁₀ at *
  simp only [polyVal] at hw₁ hw₂ hw₃ hw₄ hw₅ hw₆ hw₇ hw₈ hw₉
  have hi := toom6Interp_spec c₀ w₁ w₂ w₃ w₄ w₅ w₆ w₇ w₈ w₉ c₁₀ C₀ C₁ C₂ C₃ C₄ C₅ C₆ C₇ C₈ C₉ C₁₀
    hv₀ hv₁₀ (by rw [hw₁]; lia) (by rw [hw₂]; lia) (by rw [hw₃]; lia) (by rw [hw₄]; lia)
    (by rw [hw₅]; lia) (by rw [hw₆]; lia) (by rw [hw₇]; lia) (by rw [hw₈]; lia)
    (by rw [hw₉]; lia)
  have hlen := congrArg List.length hi
  simp only [List.length_map, List.length_cons, List.length_nil] at hlen
  rw [hab'] at hlt ⊢
  exact assemble_spec (a.size + b.size) k _ _ (by rw [hlen]; lia) hi hlt

/--
The product `a * b` by one step of Toom-6, for `32 ≤ b.size ≤ a.size`: it splits both at a sixth
of `a` when five such parts fit in `b`, and at a fifth of `b` otherwise. It is balanced for
`a.size < 6 b.size / 5`.
-/
public def toom6 (a b : UInt32Array.Slice) (hb : 32 ≤ b.size) (hab : b.size ≤ a.size)
    (mulRec : (x y : UInt32Array.Slice) → x.size + y.size < a.size + b.size → UInt32Array) :
    UInt32Array :=
  if h : 5 * ((a.size + 5) / 6) ≤ b.size then
    toom6At a b ((a.size + 5) / 6) (by lia) h hab mulRec
  else
    toom6At a b (b.size / 5) (by lia) (by lia) hab mulRec

public theorem toom6_spec (a b : UInt32Array.Slice) (hb : 32 ≤ b.size) (hab : b.size ≤ a.size)
    (mulRec : (x y : UInt32Array.Slice) → x.size + y.size < a.size + b.size → UInt32Array)
    (hrec : ∀ x y h, (mulRec x y h).size = x.size + y.size ∧
      toNat (mulRec x y h) = toNat x * toNat y) :
    (toom6 a b hb hab mulRec).size = a.size + b.size ∧
      toNat (toom6 a b hb hab mulRec) = toNat a * toNat b := by
  by_cases h : 5 * ((a.size + 5) / 6) ≤ b.size
  · have e : toom6 a b hb hab mulRec = toom6At a b ((a.size + 5) / 6) (by lia) h hab mulRec := by
      unfold toom6
      rw [dite_eq_left h]
    rw [e]
    exact toom6At_spec _ _ _ _ _ _ _ hrec
  · have e : toom6 a b hb hab mulRec = toom6At a b (b.size / 5) (by lia) (by lia) hab mulRec := by
      unfold toom6
      rw [dite_eq_right h]
    rw [e]
    exact toom6At_spec _ _ _ _ _ _ _ hrec

/-! ## Toom-6 squaring -/

/--
The square `a * a` by one step of Toom-6 at `k` limbs, for `1 ≤ k` and `5 k ≤ a.size`: the same
split, evaluations, interpolation and assembly as `toom6At a a k`, but each value is computed
once and the eleven products are squares, which `sqrRec` computes on inputs shorter than `a`.
-/
public def toom6SqrAt (a : UInt32Array.Slice) (k : Nat) (hk : 1 ≤ k) (hka : 5 * k ≤ a.size)
    (sqrRec : (x : UInt32Array.Slice) → x.size < a.size → UInt32Array) : UInt32Array :=
  let w (j : Nat) := sqrRec (evalPoly (parts6 a k) j) (by
    have := size_evalPoly_parts6 a k j
    simp only [UInt32Array.size_toSlice]; lia)
  let c₀ := sqrRec (a.slice 0 k) (by simp only [UInt32Array.Slice.size_slice]; lia)
  let c₁₀ := sqrRec (a.slice (5 * k) a.size) (by simp only [UInt32Array.Slice.size_slice]; lia)
  assembleFrom (.replicate (a.size + a.size) 0) 0 k
    (toom6Interp c₀ (w 1) (w 2) (w 3) (w 4) (w 5) (w 6) (w 7) (w 8) (w 9) c₁₀)

public theorem toom6SqrAt_spec (a : UInt32Array.Slice) (k : Nat) (hk : 1 ≤ k)
    (hka : 5 * k ≤ a.size) (sqrRec : (x : UInt32Array.Slice) → x.size < a.size → UInt32Array)
    (hrec : ∀ x h, (sqrRec x h).size = x.size + x.size ∧
      toNat (sqrRec x h) = toNat x * toNat x) :
    (toom6SqrAt a k hk hka sqrRec).size = a.size + a.size ∧
      toNat (toom6SqrAt a k hk hka sqrRec) = toNat a * toNat a := by
  have ha := toNat_parts6 a k
  have hlt : toNat a * toNat a < 2 ^ (32 * (a.size + a.size)) := by
    rw [Nat.mul_add, Nat.pow_add]
    exact Nat.mul_lt_mul'' (toNat_lt a) (toNat_lt a)
  -- The values at `j` are the squares of the values of the parts.
  have hw : ∀ j, (∀ i < 6, j ^ i < 2 ^ 32) → polyVal j (List.replicate 6 1) ≤ 2 ^ 32 → ∀ h,
      toNat (sqrRec (evalPoly (parts6 a k) j) h) =
        polyVal j (polyMul ((parts6 a k).map fun x => toNat x)
          ((parts6 a k).map fun x => toNat x)) := fun j hp hS h => by
    rw [(hrec _ h).2, polyVal_polyMul,
      toNat_evalPoly _ _ (by simpa [parts6] using hp) (by simpa [parts6] using hS)]
  obtain ⟨-, hv₀⟩ := hrec (a.slice 0 k) (by simp only [UInt32Array.Slice.size_slice]; lia)
  obtain ⟨-, hv₁₀⟩ := hrec (a.slice (5 * k) a.size)
    (by simp only [UInt32Array.Slice.size_slice]; lia)
  simp only [toom6SqrAt]
  generalize hW₁ : sqrRec (evalPoly (parts6 a k) 1) _ = w₁
  generalize hW₂ : sqrRec (evalPoly (parts6 a k) 2) _ = w₂
  generalize hW₃ : sqrRec (evalPoly (parts6 a k) 3) _ = w₃
  generalize hW₄ : sqrRec (evalPoly (parts6 a k) 4) _ = w₄
  generalize hW₅ : sqrRec (evalPoly (parts6 a k) 5) _ = w₅
  generalize hW₆ : sqrRec (evalPoly (parts6 a k) 6) _ = w₆
  generalize hW₇ : sqrRec (evalPoly (parts6 a k) 7) _ = w₇
  generalize hW₈ : sqrRec (evalPoly (parts6 a k) 8) _ = w₈
  generalize hW₉ : sqrRec (evalPoly (parts6 a k) 9) _ = w₉
  have hw₁ := hW₁ ▸ hw 1 (by decide) (by decide) _
  have hw₂ := hW₂ ▸ hw 2 (by decide) (by decide) _
  have hw₃ := hW₃ ▸ hw 3 (by decide) (by decide) _
  have hw₄ := hW₄ ▸ hw 4 (by decide) (by decide) _
  have hw₅ := hW₅ ▸ hw 5 (by decide) (by decide) _
  have hw₆ := hW₆ ▸ hw 6 (by decide) (by decide) _
  have hw₇ := hW₇ ▸ hw 7 (by decide) (by decide) _
  have hw₈ := hW₈ ▸ hw 8 (by decide) (by decide) _
  have hw₉ := hW₉ ▸ hw 9 (by decide) (by decide) _
  clear hw hW₁ hW₂ hW₃ hW₄ hW₅ hW₆ hW₇ hW₈ hW₉
  generalize sqrRec (a.slice 0 k) _ = c₀ at *
  generalize sqrRec (a.slice (5 * k) a.size) _ = c₁₀ at *
  simp only [parts6, List.map_cons, List.map_nil] at ha hw₁ hw₂ hw₃ hw₄ hw₅ hw₆ hw₇ hw₈ hw₉
  obtain ⟨C₁, C₂, C₃, C₄, C₅, C₆, C₇, C₈, C₉, hC⟩ := polyMul_six (toNat (a.slice 0 k))
    (toNat (a.slice k (2 * k))) (toNat (a.slice (2 * k) (3 * k))) (toNat (a.slice (3 * k) (4 * k)))
    (toNat (a.slice (4 * k) (5 * k))) (toNat (a.slice (5 * k) a.size)) (toNat (a.slice 0 k))
    (toNat (a.slice k (2 * k))) (toNat (a.slice (2 * k) (3 * k))) (toNat (a.slice (3 * k) (4 * k)))
    (toNat (a.slice (4 * k) (5 * k))) (toNat (a.slice (5 * k) a.size))
  rw [hC] at hw₁ hw₂ hw₃ hw₄ hw₅ hw₆ hw₇ hw₈ hw₉
  have haa : toNat a * toNat a = polyVal (2 ^ (32 * k))
      [toNat (a.slice 0 k) * toNat (a.slice 0 k), C₁, C₂, C₃, C₄, C₅, C₆, C₇, C₈, C₉,
        toNat (a.slice (5 * k) a.size) * toNat (a.slice (5 * k) a.size)] := by
    rw [ha, ← polyVal_polyMul, hC]
  generalize toNat (a.slice 0 k) * toNat (a.slice 0 k) = C₀ at *
  generalize toNat (a.slice (5 * k) a.size) * toNat (a.slice (5 * k) a.size) = C₁₀ at *
  simp only [polyVal] at hw₁ hw₂ hw₃ hw₄ hw₅ hw₆ hw₇ hw₈ hw₉
  have hi := toom6Interp_spec c₀ w₁ w₂ w₃ w₄ w₅ w₆ w₇ w₈ w₉ c₁₀ C₀ C₁ C₂ C₃ C₄ C₅ C₆ C₇ C₈ C₉ C₁₀
    hv₀ hv₁₀ (by rw [hw₁]; lia) (by rw [hw₂]; lia) (by rw [hw₃]; lia) (by rw [hw₄]; lia)
    (by rw [hw₅]; lia) (by rw [hw₆]; lia) (by rw [hw₇]; lia) (by rw [hw₈]; lia)
    (by rw [hw₉]; lia)
  have hlen := congrArg List.length hi
  simp only [List.length_map, List.length_cons, List.length_nil] at hlen
  rw [haa] at hlt ⊢
  exact assemble_spec (a.size + a.size) k _ _ (by rw [hlen]; lia) hi hlt

/-- The square `a * a` by one step of Toom-6, for `32 ≤ a.size`, split at a sixth of `a`. -/
public def toom6Sqr (a : UInt32Array.Slice) (ha : 32 ≤ a.size)
    (sqrRec : (x : UInt32Array.Slice) → x.size < a.size → UInt32Array) : UInt32Array :=
  toom6SqrAt a ((a.size + 5) / 6) (by lia) (by lia) sqrRec

public theorem toom6Sqr_spec (a : UInt32Array.Slice) (ha : 32 ≤ a.size)
    (sqrRec : (x : UInt32Array.Slice) → x.size < a.size → UInt32Array)
    (hrec : ∀ x h, (sqrRec x h).size = x.size + x.size ∧
      toNat (sqrRec x h) = toNat x * toNat x) :
    (toom6Sqr a ha sqrRec).size = a.size + a.size ∧
      toNat (toom6Sqr a ha sqrRec) = toNat a * toNat a :=
  toom6SqrAt_spec _ _ _ _ _ hrec

end MPN
