  rw [← (show q₈ = R.divExact q₇ 0 L 3 from rfl)] at s₈ e₈
  rw [s₇] at s₈
  obtain ⟨s₉, e₉⟩ := sub_val (q := w₄) (o := 0) (len := L) (by rw [hw₄]; lia) d o (k + k)
      (V := 4 * c₁ + 16 * c₂ + 64 * c₃ + 256 * c₄ + 1024 * c₅) hv₄ hc₀ (by lia)
  rw [← (show q₉ = R.subInto w₄ 0 L d o (k + k) from rfl)] at s₉ e₉
  rw [hw₄] at s₉
  obtain ⟨s₁₀, e₁₀⟩ := subMul_val (q := q₉) (o := 0) (len := L) (by rw [s₉]; lia) d (o + 5 * k) (n - 5 * k) 1024 (by decide)
      (V := 4 * c₁ + 16 * c₂ + 64 * c₃ + 256 * c₄) e₉ hc₅ (by lia)
  rw [← (show q₁₀ = R.subMulInto q₉ 0 L d (o + 5 * k) (n - 5 * k) 1024 from rfl)] at s₁₀ e₁₀
  rw [s₉] at s₁₀
  obtain ⟨s₁₁, e₁₁⟩ := shr_val (q := q₁₀) (o := 0) (len := L) (by rw [s₁₀]; lia) 2 (by decide) (by decide)
