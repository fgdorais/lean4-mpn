  rw [← (show q₁₇ = R.subInto q₁₃ 0 L q₁₄ 0 L from rfl)] at s₁₇ e₁₇
  rw [s₁₃] at s₁₇
  obtain ⟨s₁₈, e₁₈⟩ := shr_val (q := q₁₇) (o := 0) (len := L) (by rw [s₁₇]; lia) 1 (by decide) (by decide)
