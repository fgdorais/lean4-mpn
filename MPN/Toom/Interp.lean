  rw [a₃v] at a₄v
  rw [← (show A₄ = R.addInto A₃ (o + (4 * k)) (n - (4 * k)) q₂₉ (3 * L) (min (n - (4 * k)) L) from rfl)] at a₄w a₄v
  have a₄w' := a₄w.mono (o' := o) (len' := n) (by lia) (by lia) |>.trans a₃w'
