  obtain ⟨w₂₉, e₂₉⟩ := subMulWin_val (q := q₂₈) (o := (3 * L)) (len := L) (by rw [s₂₈]; lia) (4 * L) L 1
      (by rw [s₂₈]; lia) (by lia) (by lia) (by decide)
      (V := c₄) v₄q₂₈ v₅q₂₈ (by lia)
  rw [← (show q₂₉ = R.subMulWin q₂₈ (3 * L) L (4 * L) L 1 from rfl)] at w₂₉ e₂₉
  clear_value q₂₉
  have s₂₉ := w₂₉.1.trans s₂₈
  have v₁q₂₉ := (w₂₉.valAt_eq (lo := 0) (n := L) (by lia)).trans e₂₈a
