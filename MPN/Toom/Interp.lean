      (V := 3 * c₁ + 9 * c₂ + 27 * c₃ + 81 * c₄) e₆ hc₅ (by lia)
  rw [← (show q₇ = R.subMulInto q₆ 0 L d (o + 5 * k) (n - 5 * k) 243 from rfl)] at s₇ e₇
  rw [s₆] at s₇
  obtain ⟨s₈, e₈⟩ := div_val (q := q₇) (o := 0) (len := L) (by rw [s₇]; lia) 3 (by decide) (by decide)
