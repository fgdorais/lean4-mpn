/--
`interp10` on one array: the values at `1, …, 9` in the windows of `L` limbs of `W`
at `0, L, …, 8 L`, and the passes between two of them by `subMulWin`.
-/
@[expose, specialize] public def interp10W (d : A) (o n k L : Nat) (W : A) : A :=
  let W := R.subInto W 0 L d (o + 10 * k) (n - 10 * k)
  let W := R.subMulInto W L L d (o + 10 * k) (n - 10 * k) 1024
  let W := R.subMulInto W (2 * L) L d (o + 10 * k) (n - 10 * k) 59049
  let W := R.subMulInto W (3 * L) L d (o + 10 * k) (n - 10 * k) 1048576
  let W := R.subMulInto W (4 * L) L d (o + 10 * k) (n - 10 * k) 9765625
  let W := R.subMulInto W (5 * L) L d (o + 10 * k) (n - 10 * k) 60466176
  let W := R.subMulInto W (6 * L) L d (o + 10 * k) (n - 10 * k) 282475249
  let W := R.subMulInto W (7 * L) L d (o + 10 * k) (n - 10 * k) 1073741824
  let W := R.subMulInto W (8 * L) L d (o + 10 * k) (n - 10 * k) 3486784401
  let W := R.sub3Chain W (8 * L) (7 * L) (6 * L) (5 * L) L 1
  let W := R.sub3Chain W (5 * L) (4 * L) (3 * L) (2 * L) L 1
  let W := R.subMulWin W (2 * L) L L L 1
  let W := R.subMulWin W L L 0 L 1
  let W := R.subInto W 0 L d o (k + k)
  let W := R.sub3Chain W (8 * L) (7 * L) (6 * L) (5 * L) L 1
  let W := R.sub3Chain W (5 * L) (4 * L) (3 * L) (2 * L) L 1
  let W := R.subMulWin W (2 * L) L L L 1
  let W := R.subMulWin W L L 0 L 1
  let W := R.sub3Chain W (8 * L) (7 * L) (6 * L) (5 * L) L 1
  let W := R.sub3Chain W (5 * L) (4 * L) (3 * L) (2 * L) L 1
  let W := R.subMulWin W (2 * L) L L L 1
  let W := R.sub3Chain W (8 * L) (7 * L) (6 * L) (5 * L) L 1
