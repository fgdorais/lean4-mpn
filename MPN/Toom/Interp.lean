  have s₈ := w₈.1.trans s₇
  have v₁q₈ := (w₈.valAt_eq (lo := 0) (n := L) (by lia)).trans v₁q₇
  have v₃q₈ := (w₈.valAt_eq (lo := (2 * L + 1)) (n := (L - 1)) (by lia)).trans e₇
