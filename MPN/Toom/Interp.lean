/--
The interpolation of degree 6 at `0, 1, 2, 3, 4, 5, ∞`, of Toom-4: from `c₀` in the `2 k` limbs of `d`
from `o` and `c_6` from limb `o + 6 k` to `o + n`, with `w₁, …, w_5` the values at
`1, …, 5` in `L` limbs each, writes `c₀ + c₁ x + ⋯ + c_6 x^6` into the `n` limbs from `o`,
`x = 2^(w k)`.
-/
@[expose, specialize] public def interp6 (d : A) (o n k L : Nat) (w₁ w₂ w₃ w₄ w₅ : A) : A :=
  let w₁ := R.subInto w₁ 0 L d o (k + k)
  let w₁ := R.subInto w₁ 0 L d (o + 6 * k) (n - 6 * k)
  let w₂ := R.subInto w₂ 0 L d o (k + k)
  let w₂ := R.subMulInto w₂ 0 L d (o + 6 * k) (n - 6 * k) 64
  let w₂ := R.shr w₂ 0 L 1
  let w₃ := R.subInto w₃ 0 L d o (k + k)
  let w₃ := R.subMulInto w₃ 0 L d (o + 6 * k) (n - 6 * k) 729
  let w₃ := R.divExact w₃ 0 L 3
  let w₄ := R.subInto w₄ 0 L d o (k + k)
  let w₄ := R.subMulInto w₄ 0 L d (o + 6 * k) (n - 6 * k) 4096
  let w₄ := R.shr w₄ 0 L 2
  let w₅ := R.subInto w₅ 0 L d o (k + k)
  let w₅ := R.subMulInto w₅ 0 L d (o + 6 * k) (n - 6 * k) 15625
  let w₅ := R.divExact w₅ 0 L 5
  let w₅ := R.subInto w₅ 0 L w₄ 0 L
  let w₄ := R.subInto w₄ 0 L w₃ 0 L
  let w₃ := R.subInto w₃ 0 L w₂ 0 L
