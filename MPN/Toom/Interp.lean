      (V := c₃ + 3 * c₄) e₁₈ e₂₀ (by lia)
  rw [← (show q₂₁ = R.subMulInto q₁₈ 0 L q₂₀ 0 L 3 from rfl)] at s₂₁ e₂₁
  rw [s₁₈] at s₂₁
  obtain ⟨s₂₂, e₂₂⟩ := subMul_val (q := q₁₄) (o := 0) (len := L) (by rw [s₁₄]; lia) q₂₁ 0 L 2 (by decide)
      (V := c₂ + c₃ + c₄) e₁₄ e₂₁ (by lia)
  rw [← (show q₂₂ = R.subMulInto q₁₄ 0 L q₂₁ 0 L 2 from rfl)] at s₂₂ e₂₂
  rw [s₁₄] at s₂₂
  obtain ⟨s₂₃, e₂₃⟩ := subMul_val (q := q₂₁) (o := 0) (len := L) (by rw [s₂₁]; lia) q₂₀ 0 L 2 (by decide)
      (V := c₃ + c₄) e₂₁ e₂₀ (by lia)
  rw [← (show q₂₃ = R.subMulInto q₂₁ 0 L q₂₀ 0 L 2 from rfl)] at s₂₃ e₂₃
  rw [s₂₁] at s₂₃
