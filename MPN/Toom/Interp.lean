  have v₅q₂₉ := (w₂₉.valAt_eq (lo := (4 * L)) (n := L) (by lia)).trans v₅q₂₈
  clear w₂₉ v₄q₂₈ s₂₈ e₂₈a e₂₈b e₂₈c v₅q₂₈
