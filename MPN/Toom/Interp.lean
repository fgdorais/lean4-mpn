module

public import MPN.Toom.Steps

/-!
# The interpolations of the Toom methods

Generated by `scripts/toom_interp.py`; do not edit. Each interpolation of degree `D` takes `c₀`
and `c_D`, the products of the low pieces and of the top pieces, in their windows of the result,
and the values `w_j` of the product at the points `j = 1, …, D - 1` in arrays of `L` limbs, turns
the `w_j` into the coefficients `c_j` in place, and adds them into the result. The points are
natural numbers, so every intermediate value is a natural number: each subtraction takes away a
part of the value it subtracts from, and each division is exact.
-/

namespace MPN.Toom

open LimbArray

variable {A L : Type} [LA : LimbArray A L] [R : ToomOps A L]

/--
The interpolation of degree 3 at `0, 1, 2, ∞`, of Toom-3 by 2: from `c₀` in the `2 k` limbs of `d`
from `o` and `c_3` from limb `o + 3 k` to `o + n`, with `w₁, …, w_2` the values at
`1, …, 2` in `L` limbs each, writes `c₀ + c₁ x + ⋯ + c_3 x^3` into the `n` limbs from `o`,
`x = 2^(w k)`.
-/
@[expose, specialize] public def interp3 (d : A) (o n k L : Nat) (w₁ w₂ : A) : A :=
  let w₁ := R.subInto w₁ 0 L d o (k + k)
  let w₁ := R.subInto w₁ 0 L d (o + 3 * k) (n - 3 * k)
  let w₂ := R.subInto w₂ 0 L d o (k + k)
  let w₂ := R.subMulInto w₂ 0 L d (o + 3 * k) (n - 3 * k) 8
  let w₂ := R.shlTop w₂ 0 L
  let w₂ := R.subInto w₂ 1 (L - 1) w₁ 0 (L - 1)
  let w₁ := R.subInto w₁ 0 L w₂ 1 (L - 1)
  -- The recombination.
  let d := R.zeroInto d (o + (k + k)) (3 * k - (k + k))
  let d := R.addInto d (o + k) (n - k) w₁ 0 (min (n - k) L)
  R.addInto d (o + (2 * k)) (n - (2 * k)) w₂ 1 (min (n - (2 * k)) (L - 1))

public theorem interp3_spec (d : A) (o n k L : Nat) (w₁ w₂ : A) (c₀ c₁ c₂ c₃ : Nat)
    (hd : o + n ≤ LA.size d) (hk : 3 * k ≤ n) (hL : 2 ≤ L)
    (hw₁ : LA.size w₁ = L) (hw₂ : LA.size w₂ = L)
    (hc₀ : valAt d o (k + k) = c₀) (hc₃ : valAt d (o + 3 * k) (n - 3 * k) = c₃)
    (hv₁ : valAt w₁ 0 L = c₀ + c₁ + c₂ + c₃)
    (hv₂ : valAt w₂ 0 L = c₀ + 2 * c₁ + 4 * c₂ + 8 * c₃)
    (hb : c₀ + 2 * c₁ + 4 * c₂ + 8 * c₃ < 2 ^ (LA.w * (L - 1)))
    (htot : c₀ + 2 ^ (LA.w * k) * c₁ + 2 ^ (LA.w * (2 * k)) * c₂ + 2 ^ (LA.w * (3 * k)) * c₃ < 2 ^
        (LA.w * n)) :
    Writes (interp3 d o n k L w₁ w₂) d o n ∧
      valAt (interp3 d o n k L w₁ w₂) o n = c₀ + 2 ^ (LA.w * k) * c₁ + 2 ^ (LA.w * (2 * k)) * c₂ + 2
          ^ (LA.w * (3 * k)) * c₃ := by
  unfold interp3
  extract_lets q₁ q₂ q₃ q₄ q₅ q₆ q₇ A₀ A₁
  obtain ⟨s₁, e₁⟩ := sub_val (q := w₁) (o := 0) (len := L) (by rw [hw₁]; lia) d o (k + k)
      (V := c₁ + c₂ + c₃) hv₁ hc₀ (by lia)
  rw [← (show q₁ = R.subInto w₁ 0 L d o (k + k) from rfl)] at s₁ e₁
  rw [hw₁] at s₁
  obtain ⟨s₂, e₂⟩ := sub_val (q := q₁) (o := 0) (len := L) (by rw [s₁]; lia) d (o + 3 * k) (n - 3 * k)
      (V := c₁ + c₂) e₁ hc₃ (by lia)
  rw [← (show q₂ = R.subInto q₁ 0 L d (o + 3 * k) (n - 3 * k) from rfl)] at s₂ e₂
  rw [s₁] at s₂
  obtain ⟨s₃, e₃⟩ := sub_val (q := w₂) (o := 0) (len := L) (by rw [hw₂]; lia) d o (k + k)
      (V := 2 * c₁ + 4 * c₂ + 8 * c₃) hv₂ hc₀ (by lia)
  rw [← (show q₃ = R.subInto w₂ 0 L d o (k + k) from rfl)] at s₃ e₃
  rw [hw₂] at s₃
  obtain ⟨s₄, e₄⟩ := subMul_val (q := q₃) (o := 0) (len := L) (by rw [s₃]; lia) d (o + 3 * k) (n - 3 * k) 8 (by decide)
      (V := 2 * c₁ + 4 * c₂) e₃ hc₃ (by lia)
  rw [← (show q₄ = R.subMulInto q₃ 0 L d (o + 3 * k) (n - 3 * k) 8 from rfl)] at s₄ e₄
  rw [s₃] at s₄
  obtain ⟨s₅, e₅⟩ := half_val (q := q₄) (len := L) (by rw [s₄]; lia) (by lia)
      (V := c₁ + 2 * c₂) e₄ (by lia) (by lia)
  rw [← (show q₅ = R.shlTop q₄ 0 L from rfl)] at s₅ e₅
  rw [s₄] at s₅
  have l₆ := low_val (by lia) e₂ (by lia)
  obtain ⟨s₆, e₆⟩ := sub_val (q := q₅) (o := 1) (len := (L - 1)) (by rw [s₅]; lia) q₂ 0 (L - 1)
      (V := c₂) e₅ l₆ (by lia)
  rw [← (show q₆ = R.subInto q₅ 1 (L - 1) q₂ 0 (L - 1) from rfl)] at s₆ e₆
  rw [s₅] at s₆
  obtain ⟨s₇, e₇⟩ := sub_val (q := q₂) (o := 0) (len := L) (by rw [s₂]; lia) q₆ 1 (L - 1)
      (V := c₁) e₂ e₆ (by lia)
  rw [← (show q₇ = R.subInto q₂ 0 L q₆ 1 (L - 1) from rfl)] at s₇ e₇
  rw [s₂] at s₇
  -- The recombination.
  obtain ⟨z₁, z₂⟩ := zero_mid d o n (k + k) (3 * k) hd (by lia) (by lia)
  rw [hc₀, hc₃] at z₂
  rw [← (show A₀ = R.zeroInto d (o + (k + k)) (3 * k - (k + k)) from rfl)] at z₁ z₂
  replace z₁ := z₁.mono (o' := o) (len' := n) (by lia) (by lia)
  obtain ⟨a₁w, a₁v⟩ := add_coef A₀ o n k (by rw [z₁.1]; exact hd) (by lia)
      q₇ 0 L c₁ e₇ (by
    rw [z₂]
    generalize 2 ^ (LA.w * k) * c₁ = T₁ at htot ⊢
    generalize 2 ^ (LA.w * (2 * k)) * c₂ = T₂ at htot ⊢
    generalize 2 ^ (LA.w * (3 * k)) * c₃ = T₃ at htot ⊢
    lia)
  rw [z₂] at a₁v
  rw [← (show A₁ = R.addInto A₀ (o + k) (n - k) q₇ 0 (min (n - k) L) from rfl)] at a₁w a₁v
  have a₁w' := a₁w.mono (o' := o) (len' := n) (by lia) (by lia) |>.trans z₁
  obtain ⟨a₂w, a₂v⟩ := add_coef A₁ o n (2 * k) (by rw [a₁w'.1]; exact hd) (by lia)
      q₆ 1 (L - 1) c₂ e₆ (by
    rw [a₁v]
    generalize 2 ^ (LA.w * k) * c₁ = T₁ at htot ⊢
    generalize 2 ^ (LA.w * (2 * k)) * c₂ = T₂ at htot ⊢
    generalize 2 ^ (LA.w * (3 * k)) * c₃ = T₃ at htot ⊢
    lia)
  rw [a₁v] at a₂v
  refine ⟨(a₂w.mono (o' := o) (len' := n) (by lia) (by lia)).trans a₁w', ?_⟩
  rw [a₂v]
  generalize 2 ^ (LA.w * k) * c₁ = T₁ at htot ⊢
  generalize 2 ^ (LA.w * (2 * k)) * c₂ = T₂ at htot ⊢
  generalize 2 ^ (LA.w * (3 * k)) * c₃ = T₃ at htot ⊢
  lia

/--
The interpolation of degree 4 at `0, 1, 2, 3, ∞`, of Toom-3: from `c₀` in the `2 k` limbs of `d`
from `o` and `c_4` from limb `o + 4 k` to `o + n`, with `w₁, …, w_3` the values at
`1, …, 3` in `L` limbs each, writes `c₀ + c₁ x + ⋯ + c_4 x^4` into the `n` limbs from `o`,
`x = 2^(w k)`.
-/
@[expose, specialize] public def interp4 (d : A) (o n k L : Nat) (w₁ w₂ w₃ : A) : A :=
  let w₁ := R.subInto w₁ 0 L d o (k + k)
  let w₁ := R.subInto w₁ 0 L d (o + 4 * k) (n - 4 * k)
  let w₂ := R.subInto w₂ 0 L d o (k + k)
  let w₂ := R.subMulInto w₂ 0 L d (o + 4 * k) (n - 4 * k) 16
  let w₂ := R.shlTop w₂ 0 L
  let w₃ := R.subInto w₃ 0 L d o (k + k)
  let w₃ := R.subMulInto w₃ 0 L d (o + 4 * k) (n - 4 * k) 81
  let w₃ := R.divExact w₃ 0 L 3
  let w₂ := R.subInto w₂ 1 (L - 1) w₁ 0 (L - 1)
  let w₃ := R.subInto w₃ 0 L w₁ 0 L
  let w₃ := R.shlTop w₃ 0 L
  let w₃ := R.subInto w₃ 1 (L - 1) w₂ 1 (L - 1)
  let w₂ := R.subMulInto w₂ 1 (L - 1) w₃ 1 (L - 1) 3
  let w₁ := R.subInto w₁ 0 L w₂ 1 (L - 1)
  let w₁ := R.subInto w₁ 0 L w₃ 1 (L - 1)
  -- The recombination.
  let d := R.zeroInto d (o + (k + k)) (4 * k - (k + k))
  let d := R.addInto d (o + k) (n - k) w₁ 0 (min (n - k) L)
  let d := R.addInto d (o + (2 * k)) (n - (2 * k)) w₂ 1 (min (n - (2 * k)) (L - 1))
  R.addInto d (o + (3 * k)) (n - (3 * k)) w₃ 1 (min (n - (3 * k)) (L - 1))

public theorem interp4_spec (d : A) (o n k L : Nat) (w₁ w₂ w₃ : A) (c₀ c₁ c₂ c₃ c₄ : Nat)
    (hd : o + n ≤ LA.size d) (hk : 4 * k ≤ n) (hL : 2 ≤ L)
    (hw₁ : LA.size w₁ = L) (hw₂ : LA.size w₂ = L) (hw₃ : LA.size w₃ = L)
    (hc₀ : valAt d o (k + k) = c₀) (hc₄ : valAt d (o + 4 * k) (n - 4 * k) = c₄)
    (hv₁ : valAt w₁ 0 L = c₀ + c₁ + c₂ + c₃ + c₄)
    (hv₂ : valAt w₂ 0 L = c₀ + 2 * c₁ + 4 * c₂ + 8 * c₃ + 16 * c₄)
    (hv₃ : valAt w₃ 0 L = c₀ + 3 * c₁ + 9 * c₂ + 27 * c₃ + 81 * c₄)
    (hb : c₀ + 3 * c₁ + 9 * c₂ + 27 * c₃ + 81 * c₄ < 2 ^ (LA.w * (L - 1)))
    (htot : c₀ + 2 ^ (LA.w * k) * c₁ + 2 ^ (LA.w * (2 * k)) * c₂ + 2 ^ (LA.w * (3 * k)) * c₃ + 2 ^
        (LA.w * (4 * k)) * c₄ < 2 ^ (LA.w * n)) :
    Writes (interp4 d o n k L w₁ w₂ w₃) d o n ∧
      valAt (interp4 d o n k L w₁ w₂ w₃) o n = c₀ + 2 ^ (LA.w * k) * c₁ + 2 ^ (LA.w * (2 * k)) * c₂
          + 2 ^ (LA.w * (3 * k)) * c₃ + 2 ^ (LA.w * (4 * k)) * c₄ := by
  unfold interp4
  extract_lets q₁ q₂ q₃ q₄ q₅ q₆ q₇ q₈ q₉ q₁₀ q₁₁ q₁₂ q₁₃ q₁₄ q₁₅ A₀ A₁ A₂
  obtain ⟨s₁, e₁⟩ := sub_val (q := w₁) (o := 0) (len := L) (by rw [hw₁]; lia) d o (k + k)
      (V := c₁ + c₂ + c₃ + c₄) hv₁ hc₀ (by lia)
  rw [← (show q₁ = R.subInto w₁ 0 L d o (k + k) from rfl)] at s₁ e₁
  rw [hw₁] at s₁
  obtain ⟨s₂, e₂⟩ := sub_val (q := q₁) (o := 0) (len := L) (by rw [s₁]; lia) d (o + 4 * k) (n - 4 * k)
      (V := c₁ + c₂ + c₃) e₁ hc₄ (by lia)
  rw [← (show q₂ = R.subInto q₁ 0 L d (o + 4 * k) (n - 4 * k) from rfl)] at s₂ e₂
  rw [s₁] at s₂
  obtain ⟨s₃, e₃⟩ := sub_val (q := w₂) (o := 0) (len := L) (by rw [hw₂]; lia) d o (k + k)
      (V := 2 * c₁ + 4 * c₂ + 8 * c₃ + 16 * c₄) hv₂ hc₀ (by lia)
  rw [← (show q₃ = R.subInto w₂ 0 L d o (k + k) from rfl)] at s₃ e₃
  rw [hw₂] at s₃
  obtain ⟨s₄, e₄⟩ := subMul_val (q := q₃) (o := 0) (len := L) (by rw [s₃]; lia) d (o + 4 * k) (n - 4 * k) 16 (by decide)
      (V := 2 * c₁ + 4 * c₂ + 8 * c₃) e₃ hc₄ (by lia)
  rw [← (show q₄ = R.subMulInto q₃ 0 L d (o + 4 * k) (n - 4 * k) 16 from rfl)] at s₄ e₄
  rw [s₃] at s₄
  obtain ⟨s₅, e₅⟩ := half_val (q := q₄) (len := L) (by rw [s₄]; lia) (by lia)
      (V := c₁ + 2 * c₂ + 4 * c₃) e₄ (by lia) (by lia)
  rw [← (show q₅ = R.shlTop q₄ 0 L from rfl)] at s₅ e₅
  rw [s₄] at s₅
  obtain ⟨s₆, e₆⟩ := sub_val (q := w₃) (o := 0) (len := L) (by rw [hw₃]; lia) d o (k + k)
      (V := 3 * c₁ + 9 * c₂ + 27 * c₃ + 81 * c₄) hv₃ hc₀ (by lia)
  rw [← (show q₆ = R.subInto w₃ 0 L d o (k + k) from rfl)] at s₆ e₆
  rw [hw₃] at s₆
  obtain ⟨s₇, e₇⟩ := subMul_val (q := q₆) (o := 0) (len := L) (by rw [s₆]; lia) d (o + 4 * k) (n - 4 * k) 81 (by decide)
      (V := 3 * c₁ + 9 * c₂ + 27 * c₃) e₆ hc₄ (by lia)
  rw [← (show q₇ = R.subMulInto q₆ 0 L d (o + 4 * k) (n - 4 * k) 81 from rfl)] at s₇ e₇
  rw [s₆] at s₇
  obtain ⟨s₈, e₈⟩ := div_val (q := q₇) (o := 0) (len := L) (by rw [s₇]; lia) 3 (by decide) (by decide)
      (V := c₁ + 3 * c₂ + 9 * c₃) e₇ (by lia)
  rw [← (show q₈ = R.divExact q₇ 0 L 3 from rfl)] at s₈ e₈
  rw [s₇] at s₈
  have l₉ := low_val (by lia) e₂ (by lia)
  obtain ⟨s₉, e₉⟩ := sub_val (q := q₅) (o := 1) (len := (L - 1)) (by rw [s₅]; lia) q₂ 0 (L - 1)
      (V := c₂ + 3 * c₃) e₅ l₉ (by lia)
  rw [← (show q₉ = R.subInto q₅ 1 (L - 1) q₂ 0 (L - 1) from rfl)] at s₉ e₉
  rw [s₅] at s₉
  obtain ⟨s₁₀, e₁₀⟩ := sub_val (q := q₈) (o := 0) (len := L) (by rw [s₈]; lia) q₂ 0 L
      (V := 2 * c₂ + 8 * c₃) e₈ e₂ (by lia)
  rw [← (show q₁₀ = R.subInto q₈ 0 L q₂ 0 L from rfl)] at s₁₀ e₁₀
  rw [s₈] at s₁₀
  obtain ⟨s₁₁, e₁₁⟩ := half_val (q := q₁₀) (len := L) (by rw [s₁₀]; lia) (by lia)
      (V := c₂ + 4 * c₃) e₁₀ (by lia) (by lia)
  rw [← (show q₁₁ = R.shlTop q₁₀ 0 L from rfl)] at s₁₁ e₁₁
  rw [s₁₀] at s₁₁
  obtain ⟨s₁₂, e₁₂⟩ := sub_val (q := q₁₁) (o := 1) (len := (L - 1)) (by rw [s₁₁]; lia) q₉ 1 (L - 1)
      (V := c₃) e₁₁ e₉ (by lia)
  rw [← (show q₁₂ = R.subInto q₁₁ 1 (L - 1) q₉ 1 (L - 1) from rfl)] at s₁₂ e₁₂
  rw [s₁₁] at s₁₂
  obtain ⟨s₁₃, e₁₃⟩ := subMul_val (q := q₉) (o := 1) (len := (L - 1)) (by rw [s₉]; lia) q₁₂ 1 (L - 1) 3 (by decide)
      (V := c₂) e₉ e₁₂ (by lia)
  rw [← (show q₁₃ = R.subMulInto q₉ 1 (L - 1) q₁₂ 1 (L - 1) 3 from rfl)] at s₁₃ e₁₃
  rw [s₉] at s₁₃
  obtain ⟨s₁₄, e₁₄⟩ := sub_val (q := q₂) (o := 0) (len := L) (by rw [s₂]; lia) q₁₃ 1 (L - 1)
      (V := c₁ + c₃) e₂ e₁₃ (by lia)
  rw [← (show q₁₄ = R.subInto q₂ 0 L q₁₃ 1 (L - 1) from rfl)] at s₁₄ e₁₄
  rw [s₂] at s₁₄
  obtain ⟨s₁₅, e₁₅⟩ := sub_val (q := q₁₄) (o := 0) (len := L) (by rw [s₁₄]; lia) q₁₂ 1 (L - 1)
      (V := c₁) e₁₄ e₁₂ (by lia)
  rw [← (show q₁₅ = R.subInto q₁₄ 0 L q₁₂ 1 (L - 1) from rfl)] at s₁₅ e₁₅
  rw [s₁₄] at s₁₅
  -- The recombination.
  obtain ⟨z₁, z₂⟩ := zero_mid d o n (k + k) (4 * k) hd (by lia) (by lia)
  rw [hc₀, hc₄] at z₂
  rw [← (show A₀ = R.zeroInto d (o + (k + k)) (4 * k - (k + k)) from rfl)] at z₁ z₂
  replace z₁ := z₁.mono (o' := o) (len' := n) (by lia) (by lia)
  obtain ⟨a₁w, a₁v⟩ := add_coef A₀ o n k (by rw [z₁.1]; exact hd) (by lia)
      q₁₅ 0 L c₁ e₁₅ (by
    rw [z₂]
    generalize 2 ^ (LA.w * k) * c₁ = T₁ at htot ⊢
    generalize 2 ^ (LA.w * (2 * k)) * c₂ = T₂ at htot ⊢
    generalize 2 ^ (LA.w * (3 * k)) * c₃ = T₃ at htot ⊢
    generalize 2 ^ (LA.w * (4 * k)) * c₄ = T₄ at htot ⊢
    lia)
  rw [z₂] at a₁v
  rw [← (show A₁ = R.addInto A₀ (o + k) (n - k) q₁₅ 0 (min (n - k) L) from rfl)] at a₁w a₁v
  have a₁w' := a₁w.mono (o' := o) (len' := n) (by lia) (by lia) |>.trans z₁
  obtain ⟨a₂w, a₂v⟩ := add_coef A₁ o n (2 * k) (by rw [a₁w'.1]; exact hd) (by lia)
      q₁₃ 1 (L - 1) c₂ e₁₃ (by
    rw [a₁v]
    generalize 2 ^ (LA.w * k) * c₁ = T₁ at htot ⊢
    generalize 2 ^ (LA.w * (2 * k)) * c₂ = T₂ at htot ⊢
    generalize 2 ^ (LA.w * (3 * k)) * c₃ = T₃ at htot ⊢
    generalize 2 ^ (LA.w * (4 * k)) * c₄ = T₄ at htot ⊢
    lia)
  rw [a₁v] at a₂v
  rw [← (show A₂ = R.addInto A₁ (o + (2 * k)) (n - (2 * k)) q₁₃ 1 (min (n - (2 * k)) (L - 1)) from rfl)] at a₂w a₂v
  have a₂w' := a₂w.mono (o' := o) (len' := n) (by lia) (by lia) |>.trans a₁w'
  obtain ⟨a₃w, a₃v⟩ := add_coef A₂ o n (3 * k) (by rw [a₂w'.1]; exact hd) (by lia)
      q₁₂ 1 (L - 1) c₃ e₁₂ (by
    rw [a₂v]
    generalize 2 ^ (LA.w * k) * c₁ = T₁ at htot ⊢
    generalize 2 ^ (LA.w * (2 * k)) * c₂ = T₂ at htot ⊢
    generalize 2 ^ (LA.w * (3 * k)) * c₃ = T₃ at htot ⊢
    generalize 2 ^ (LA.w * (4 * k)) * c₄ = T₄ at htot ⊢
    lia)
  rw [a₂v] at a₃v
  refine ⟨(a₃w.mono (o' := o) (len' := n) (by lia) (by lia)).trans a₂w', ?_⟩
  rw [a₃v]
  generalize 2 ^ (LA.w * k) * c₁ = T₁ at htot ⊢
  generalize 2 ^ (LA.w * (2 * k)) * c₂ = T₂ at htot ⊢
  generalize 2 ^ (LA.w * (3 * k)) * c₃ = T₃ at htot ⊢
  generalize 2 ^ (LA.w * (4 * k)) * c₄ = T₄ at htot ⊢
  lia

/--
The interpolation of degree 5 at `0, 1, 2, 3, 4, ∞`, of Toom-4 by 3: from `c₀` in the `2 k` limbs of `d`
from `o` and `c_5` from limb `o + 5 k` to `o + n`, with `w₁, …, w_4` the values at
`1, …, 4` in `L` limbs each, writes `c₀ + c₁ x + ⋯ + c_5 x^5` into the `n` limbs from `o`,
`x = 2^(w k)`.
-/
@[expose, specialize] public def interp5 (d : A) (o n k L : Nat) (w₁ w₂ w₃ w₄ : A) : A :=
  let w₁ := R.subInto w₁ 0 L d o (k + k)
  let w₁ := R.subInto w₁ 0 L d (o + 5 * k) (n - 5 * k)
  let w₂ := R.subInto w₂ 0 L d o (k + k)
  let w₂ := R.subMulInto w₂ 0 L d (o + 5 * k) (n - 5 * k) 32
  let w₂ := R.shr w₂ 0 L 1
  let w₃ := R.subInto w₃ 0 L d o (k + k)
  let w₃ := R.subMulInto w₃ 0 L d (o + 5 * k) (n - 5 * k) 243
  let w₃ := R.divExact w₃ 0 L 3
  let w₄ := R.subInto w₄ 0 L d o (k + k)
  let w₄ := R.subMulInto w₄ 0 L d (o + 5 * k) (n - 5 * k) 1024
  let w₄ := R.shr w₄ 0 L 2
  let w₄ := R.subInto w₄ 0 L w₃ 0 L
  let w₃ := R.subInto w₃ 0 L w₂ 0 L
  let w₂ := R.subInto w₂ 0 L w₁ 0 L
  let w₄ := R.subInto w₄ 0 L w₃ 0 L
  let w₄ := R.shr w₄ 0 L 1
  let w₃ := R.subInto w₃ 0 L w₂ 0 L
  let w₃ := R.shr w₃ 0 L 1
  let w₄ := R.subInto w₄ 0 L w₃ 0 L
  let w₄ := R.divExact w₄ 0 L 3
  let w₃ := R.subMulInto w₃ 0 L w₄ 0 L 3
  let w₂ := R.subMulInto w₂ 0 L w₃ 0 L 2
  let w₃ := R.subMulInto w₃ 0 L w₄ 0 L 2
  let w₁ := R.subInto w₁ 0 L w₂ 0 L
  let w₂ := R.subInto w₂ 0 L w₃ 0 L
  let w₃ := R.subInto w₃ 0 L w₄ 0 L
  -- The recombination.
  let d := R.zeroInto d (o + (k + k)) (5 * k - (k + k))
  let d := R.addInto d (o + k) (n - k) w₁ 0 (min (n - k) L)
  let d := R.addInto d (o + (2 * k)) (n - (2 * k)) w₂ 0 (min (n - (2 * k)) L)
  let d := R.addInto d (o + (3 * k)) (n - (3 * k)) w₃ 0 (min (n - (3 * k)) L)
  R.addInto d (o + (4 * k)) (n - (4 * k)) w₄ 0 (min (n - (4 * k)) L)

set_option maxHeartbeats 1000000 in
public theorem interp5_spec (d : A) (o n k L : Nat) (w₁ w₂ w₃ w₄ : A) (c₀ c₁ c₂ c₃ c₄ c₅ : Nat)
    (hd : o + n ≤ LA.size d) (hk : 5 * k ≤ n) (_hL : 2 ≤ L)
    (hw₁ : LA.size w₁ = L) (hw₂ : LA.size w₂ = L) (hw₃ : LA.size w₃ = L) (hw₄ : LA.size w₄ = L)
    (hc₀ : valAt d o (k + k) = c₀) (hc₅ : valAt d (o + 5 * k) (n - 5 * k) = c₅)
    (hv₁ : valAt w₁ 0 L = c₀ + c₁ + c₂ + c₃ + c₄ + c₅)
    (hv₂ : valAt w₂ 0 L = c₀ + 2 * c₁ + 4 * c₂ + 8 * c₃ + 16 * c₄ + 32 * c₅)
    (hv₃ : valAt w₃ 0 L = c₀ + 3 * c₁ + 9 * c₂ + 27 * c₃ + 81 * c₄ + 243 * c₅)
    (hv₄ : valAt w₄ 0 L = c₀ + 4 * c₁ + 16 * c₂ + 64 * c₃ + 256 * c₄ + 1024 * c₅)
    (htot : c₀ + 2 ^ (LA.w * k) * c₁ + 2 ^ (LA.w * (2 * k)) * c₂ + 2 ^ (LA.w * (3 * k)) * c₃ + 2 ^
        (LA.w * (4 * k)) * c₄ + 2 ^ (LA.w * (5 * k)) * c₅ < 2 ^ (LA.w * n)) :
    Writes (interp5 d o n k L w₁ w₂ w₃ w₄) d o n ∧
      valAt (interp5 d o n k L w₁ w₂ w₃ w₄) o n = c₀ + 2 ^ (LA.w * k) * c₁ + 2 ^ (LA.w * (2 * k)) *
          c₂ + 2 ^ (LA.w * (3 * k)) * c₃ + 2 ^ (LA.w * (4 * k)) * c₄ + 2 ^ (LA.w * (5 * k)) * c₅ :=
          by
  unfold interp5
  extract_lets q₁ q₂ q₃ q₄ q₅ q₆ q₇ q₈ q₉ q₁₀ q₁₁ q₁₂ q₁₃ q₁₄ q₁₅ q₁₆ q₁₇ q₁₈ q₁₉ q₂₀ q₂₁ q₂₂ q₂₃
     q₂₄ q₂₅ q₂₆ A₀ A₁ A₂ A₃
  obtain ⟨s₁, e₁⟩ := sub_val (q := w₁) (o := 0) (len := L) (by rw [hw₁]; lia) d o (k + k)
      (V := c₁ + c₂ + c₃ + c₄ + c₅) hv₁ hc₀ (by lia)
  rw [← (show q₁ = R.subInto w₁ 0 L d o (k + k) from rfl)] at s₁ e₁
  rw [hw₁] at s₁
  obtain ⟨s₂, e₂⟩ := sub_val (q := q₁) (o := 0) (len := L) (by rw [s₁]; lia) d (o + 5 * k) (n - 5 * k)
      (V := c₁ + c₂ + c₃ + c₄) e₁ hc₅ (by lia)
  rw [← (show q₂ = R.subInto q₁ 0 L d (o + 5 * k) (n - 5 * k) from rfl)] at s₂ e₂
  rw [s₁] at s₂
  obtain ⟨s₃, e₃⟩ := sub_val (q := w₂) (o := 0) (len := L) (by rw [hw₂]; lia) d o (k + k)
      (V := 2 * c₁ + 4 * c₂ + 8 * c₃ + 16 * c₄ + 32 * c₅) hv₂ hc₀ (by lia)
  rw [← (show q₃ = R.subInto w₂ 0 L d o (k + k) from rfl)] at s₃ e₃
  rw [hw₂] at s₃
  obtain ⟨s₄, e₄⟩ := subMul_val (q := q₃) (o := 0) (len := L) (by rw [s₃]; lia) d (o + 5 * k) (n - 5 * k) 32 (by decide)
      (V := 2 * c₁ + 4 * c₂ + 8 * c₃ + 16 * c₄) e₃ hc₅ (by lia)
  rw [← (show q₄ = R.subMulInto q₃ 0 L d (o + 5 * k) (n - 5 * k) 32 from rfl)] at s₄ e₄
  rw [s₃] at s₄
  obtain ⟨s₅, e₅⟩ := shr_val (q := q₄) (o := 0) (len := L) (by rw [s₄]; lia) 1 (by decide) (by decide)
