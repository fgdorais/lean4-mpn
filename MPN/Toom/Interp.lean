  let W := R.subMulWin W (5 * L) L (4 * L) L 1
  let W := R.subMulWin W (4 * L) L (3 * L) L 1
  let W := R.sub3Chain W (8 * L) (7 * L) (6 * L) (5 * L) L 1
  let W := R.subMulWin W (5 * L) L (4 * L) L 1
  let W := R.sub3Chain W (8 * L) (7 * L) (6 * L) (5 * L) L 1
  let W := R.subMulWin W (8 * L) L (7 * L) L 1
  let W := R.subMulWin W (7 * L) L (6 * L) L 1
  let W := R.subMulWin W (8 * L) L (7 * L) L 1
  let W := R.shr W L L 1
  let W := R.divExact W (2 * L) L 3
  let W := R.shr W (2 * L) L 1
  let W := R.divExact W (3 * L) L 3
  let W := R.shr W (3 * L) L 3
  let W := R.divExact W (4 * L) L 15
  let W := R.shr W (4 * L) L 3
  let W := R.divExact W (5 * L) L 45
  let W := R.shr W (5 * L) L 4
  let W := R.divExact W (6 * L) L 315
  let W := R.shr W (6 * L) L 4
  let W := R.divExact W (7 * L) L 315
  let W := R.shr W (7 * L) L 7
  let W := R.divExact W (8 * L) L 2835
  let W := R.shr W (8 * L) L 7
  let W := R.subMulWin W (7 * L) L (8 * L) L 8
