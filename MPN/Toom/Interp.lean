  rw [← (show q₁₁ = R.shr q₁₀ 0 L 2 from rfl)] at s₁₁ e₁₁
  rw [s₁₀] at s₁₁
  obtain ⟨s₁₂, e₁₂⟩ := sub_val (q := q₁₁) (o := 0) (len := L) (by rw [s₁₁]; lia) q₈ 0 L
      (V := c₂ + 7 * c₃ + 37 * c₄) e₁₁ e₈ (by lia)
  rw [← (show q₁₂ = R.subInto q₁₁ 0 L q₈ 0 L from rfl)] at s₁₂ e₁₂
  rw [s₁₁] at s₁₂
  obtain ⟨s₁₃, e₁₃⟩ := sub_val (q := q₈) (o := 0) (len := L) (by rw [s₈]; lia) q₅ 0 L
