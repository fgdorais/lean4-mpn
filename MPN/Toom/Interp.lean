  have v₃q₉ := (w₉.valAt_eq (lo := (2 * L + 1)) (n := (L - 1)) (by lia)).trans v₃q₈
  obtain ⟨w₁₀, e₁₀⟩ := subMulWin_val (q := q₉) (o := 0) (len := L) (by rw [s₉]; lia) (2 * L + 1) (L - 1) 1
      (by rw [s₉]; lia) (by lia) (by lia) (by decide)
