  rw [← (show q₁₉ = R.subInto q₁₆ 0 L q₁₈ 0 L from rfl)] at s₁₉ e₁₉
  rw [s₁₆] at s₁₉
  obtain ⟨s₂₀, e₂₀⟩ := div_val (q := q₁₉) (o := 0) (len := L) (by rw [s₁₉]; lia) 3 (by decide) (by decide)
