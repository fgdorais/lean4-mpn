  rw [← (show q₁ = R.sub3Lin W 0 L (2 * L) L d o (k + k) (o + 6 * k) (n - 6 * k) 1 64 729 from rfl)] at w₁ e₁a e₁b e₁c
  have s₁ := w₁.1.trans hW
