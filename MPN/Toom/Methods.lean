module

public import MPN.Toom.Toom

/-!
# The Toom methods

Generated by `scripts/toom_methods.py`; do not edit. Each method splits `a` into `p` pieces of `k`
limbs and `b` into `q`, or squares `a`, writes the product of the low pieces and the product of
the top pieces into the window of the result and the products of the values at `1, …, D - 1`,
`D = p + q - 2`, into new arrays of `2 k + 2` limbs, and interpolates. Toom-3, Toom-3 by 2,
Toom-4 by 2, Toom-4 and the Toom-3 and Toom-4 squares keep the values of each operand and their
products or squares in windows of one array each instead (`pointsW`, `pointsSqrW`, `interpDW`). The
products are those of a multiplier `mul` given as an argument, which `mulToom` makes recursive.
-/

namespace MPN.Toom

open LimbArray

variable {A L : Type} [LA : LimbArray A L] [R : ToomOps A L]

/--
The shape of Toom-3: 3 pieces of `k` limbs of `a` and 3 of `b`, at most, the top ones
nonempty.
-/
public abbrev Shape33 (al bl k : Nat) : Prop :=
  1 ≤ k ∧ 2 * k < al ∧ al ≤ 3 * k ∧ 2 * k < bl ∧ bl ≤ al

/--
Toom-3: `a` in 3 pieces of `k` limbs and `b` in 3, at most, the top ones nonempty, the values
and their products in windows of one array each (`pointsW`).
-/
@[expose, specialize] public def toom33 (d : A) (o : Nat) (a : A) (ao al : Nat) (b : A)
    (bo bl k : Nat) (hk : Shape33 al bl k) (mul : MulFn A (al + bl)) : A :=
  let d := mul d o a ao k b bo k (by obtain ⟨_, _, _, _, _⟩ := hk; lia)
  let d := mul d (o + 4 * k) a (ao + 2 * k) (al - 2 * k) b (bo + 2 * k)
    (bl - 2 * k) (by obtain ⟨_, _, _, _, _⟩ := hk; lia)
  interp4W d o (al + bl) k (k + k + 2)
    (pointsW mul a ao al b bo bl k 3 3 3 (by obtain ⟨_, _, _, _, _⟩ := hk; lia))

public theorem toom33_spec (d : A) (o : Nat) (a : A) (ao al : Nat) (b : A) (bo bl k : Nat)
    (hk : Shape33 al bl k) (mul : MulFn A (al + bl)) (hmul : IsMul mul)
    (hd : o + (al + bl) ≤ LA.size d) :
    Writes (toom33 d o a ao al b bo bl k hk mul) d o (al + bl) ∧
      valAt (toom33 d o a ao al b bo bl k hk mul) o (al + bl) = valAt a ao al * valAt b bo bl := by
  obtain ⟨hk₁, ha₁, ha₂, hb₁, hb₂⟩ := hk
  dsimp only [toom33]
  have hab := mul_lt a b ao al bo bl
  have hA := valAt_eq_pieces a k 3 ao al (by lia)
  have hB := valAt_eq_pieces b k 3 bo bl (by lia)
  have pA (j : Nat) (hj : 1 ≤ j) := point_spec mul hmul a ao al b bo bl k 3 3 j (by decide)
    (by decide) hj
  simp only [sumRange_succ, sumRange_zero, Nat.zero_add, Nat.pow_zero, Nat.mul_one,
    Nat.pow_one] at hA hB pA
  obtain ⟨sW, pW⟩ := pointsW_spec mul hmul a ao al b bo bl k 3 3 3 (by decide) (by decide)
    (fun j hj => match j, hj with | 0, _ | 1, _ | 2, _ | 3, _ => by decide | _ + 4, h => absurd h (by lia))
    (fun j hj => match j, hj with | 0, _ | 1, _ | 2, _ | 3, _ => by decide | _ + 4, h => absurd h (by lia))
    (by lia)
  have e₁ := pW 1 (by decide) (by decide)
  rw [show (1 - 1) * (k + k + 2) = 0 by lia] at e₁
  have e₂ := pW 2 (by decide) (by decide)
  rw [show (2 - 1) * (k + k + 2) = (k + k + 2) by lia] at e₂
  have e₃ := pW 3 (by decide) (by decide)
  rw [show (3 - 1) * (k + k + 2) = 2 * (k + k + 2) by lia] at e₃
  simp only [sumRange_succ, sumRange_zero, Nat.zero_add, Nat.pow_zero, Nat.mul_one,
    Nat.pow_one] at e₁ e₂ e₃
  have a₀ := piece_full a ao al k 0 (by lia)
  have aT := piece_top a ao al k 2 (by lia)
  have b₀ := piece_full b bo bl k 0 (by lia)
  have bT := piece_top b bo bl k 2 (by lia)
  simp only [Nat.zero_mul, Nat.add_zero] at a₀ aT b₀ bT
  have lA₀ := piece_lt a ao al k 0
  have lA₁ := piece_lt a ao al k 1
  have lA₂ := piece_lt a ao al k 2
  have lB₀ := piece_lt b bo bl k 0
  have lB₁ := piece_lt b bo bl k 1
  have lB₂ := piece_lt b bo bl k 2
  generalize piece a ao al k 0 = A₀ at *
  generalize piece a ao al k 1 = A₁ at *
  generalize piece a ao al k 2 = A₂ at *
  generalize piece b bo bl k 0 = B₀ at *
  generalize piece b bo bl k 1 = B₁ at *
  generalize piece b bo bl k 2 = B₂ at *
  -- The products of the low pieces and of the top pieces.
  have p₁ : k + k < al + bl := by lia
  obtain ⟨w₁, v₁⟩ := hmul d o a ao k b bo k p₁ (by lia)
  rw [← a₀, ← b₀] at v₁
  generalize mul d o a ao k b bo k p₁ = d₁ at *
  have p₂ : al - 2 * k + (bl - 2 * k) < al + bl := by lia
  obtain ⟨w₂, v₂⟩ := hmul d₁ (o + 4 * k) a (ao + 2 * k) (al - 2 * k) b (bo + 2 * k)
    (bl - 2 * k) p₂ (by rw [w₁.1]; lia)
  rw [← aT, ← bT, show al - 2 * k + (bl - 2 * k) = al + bl - 4 * k by lia] at v₂
  rw [show al - 2 * k + (bl - 2 * k) = al + bl - 4 * k by lia] at w₂
  generalize mul d₁ (o + 4 * k) a (ao + 2 * k) (al - 2 * k) b (bo + 2 * k)
    (bl - 2 * k) p₂ = d₂ at *
  have hc₀ : valAt d₂ o (k + k) = A₀ * B₀ := by rw [← v₁]; exact w₂.valAt_eq (by lia)
  -- The values at the points.
  have p₃ : k + 1 + (k + 1) < al + bl := by lia
  -- The interpolation.
  generalize hX : 2 ^ (LA.w * k) = X at *
  have hX2 : 2 ^ (LA.w * (2 * k)) = X * X := by rw [pow_mul_k, hX]; grind
  have hX3 : 2 ^ (LA.w * (3 * k)) = X * X * X := by rw [pow_mul_k, hX]; grind
  have hX4 : 2 ^ (LA.w * (4 * k)) = X * X * X * X := by rw [pow_mul_k, hX]; grind
  have hval : valAt a ao al * valAt b bo bl =
      (A₀ * B₀) + X * (A₀ * B₁ + A₁ * B₀) + X * X * (A₀ * B₂ + A₁ * B₁ + A₂ * B₀) + X * X * X * (A₁ * B₂ + A₂ * B₁) + X * X * X * X * (A₂ * B₂) := by
    rw [hA, hB]; grind
  have hbm : (A₀ + A₁ * 3 + A₂ * 3 ^ 2) * (B₀ + B₁ * 3 + B₂ * 3 ^ 2) < 2 ^ (LA.w * (k + k + 2 - 1)) := by
    have h32 : 2 ^ 32 ≤ 2 ^ LA.w := Nat.pow_le_pow_right (by decide) R.w_ge
    rw [show 2 ^ (LA.w * (k + k + 2 - 1)) = X * X * 2 ^ LA.w by
      rw [← hX, ← Nat.pow_add, ← Nat.pow_add]; congr 1; lia]
    have := Nat.mul_lt_mul_of_lt_of_lt (show A₀ + A₁ * 3 + A₂ * 3 ^ 2 < 13 * X by lia)
      (show B₀ + B₁ * 3 + B₂ * 3 ^ 2 < 13 * X by lia)
    rw [show 13 * X * (13 * X) = 169 * (X * X) by grind] at this
    have := Nat.mul_le_mul_left (X * X) h32
    lia
  obtain ⟨f₁, f₂⟩ := interp4W_spec d₂ o (al + bl) k (k + k + 2) _ 
    (A₀ * B₀) (A₀ * B₁ + A₁ * B₀) (A₀ * B₂ + A₁ * B₁ + A₂ * B₀) (A₁ * B₂ + A₂ * B₁) (A₂ * B₂)
    (by rw [w₂.1, w₁.1]; exact hd) (by lia) (by lia) sW hc₀ v₂
    (by rw [e₁]; grind)
    (by rw [e₂]; grind)
    (by rw [e₃]; grind)
    (by refine Nat.lt_of_le_of_lt (Nat.le_of_eq ?_) hbm; grind)
    (by rw [hX, hX2, hX3, hX4, ← hval]; exact hab)
  rw [hX, hX2, hX3, hX4, ← hval] at f₂
  exact ⟨f₁.trans ((w₂.mono (by lia) (by lia)).trans (w₁.mono (by lia) (by lia))), f₂⟩

/--
The shape of Toom-4 by 2: 4 pieces of `k` limbs of `a` and 2 of `b`, at most, the top ones
nonempty.
-/
public abbrev Shape42 (al bl k : Nat) : Prop :=
  1 ≤ k ∧ 3 * k < al ∧ al ≤ 4 * k ∧ k < bl ∧ bl ≤ 2 * k

/--
Toom-4 by 2: `a` in 4 pieces of `k` limbs and `b` in 2, at most, the top ones nonempty, the values
and their products in windows of one array each (`pointsW`).
-/
@[expose, specialize] public def toom42 (d : A) (o : Nat) (a : A) (ao al : Nat) (b : A)
    (bo bl k : Nat) (hk : Shape42 al bl k) (mul : MulFn A (al + bl)) : A :=
  let d := mul d o a ao k b bo k (by obtain ⟨_, _, _, _, _⟩ := hk; lia)
  let d := mul d (o + 4 * k) a (ao + 3 * k) (al - 3 * k) b (bo + k)
    (bl - k) (by obtain ⟨_, _, _, _, _⟩ := hk; lia)
  interp4W d o (al + bl) k (k + k + 2)
    (pointsW mul a ao al b bo bl k 4 2 3 (by obtain ⟨_, _, _, _, _⟩ := hk; lia))

public theorem toom42_spec (d : A) (o : Nat) (a : A) (ao al : Nat) (b : A) (bo bl k : Nat)
    (hk : Shape42 al bl k) (mul : MulFn A (al + bl)) (hmul : IsMul mul)
    (hd : o + (al + bl) ≤ LA.size d) :
    Writes (toom42 d o a ao al b bo bl k hk mul) d o (al + bl) ∧
      valAt (toom42 d o a ao al b bo bl k hk mul) o (al + bl) = valAt a ao al * valAt b bo bl := by
  obtain ⟨hk₁, ha₁, ha₂, hb₁, hb₂⟩ := hk
  dsimp only [toom42]
  have hab := mul_lt a b ao al bo bl
  have hA := valAt_eq_pieces a k 4 ao al (by lia)
  have hB := valAt_eq_pieces b k 2 bo bl (by lia)
  have pA (j : Nat) (hj : 1 ≤ j) := point_spec mul hmul a ao al b bo bl k 4 2 j (by decide)
    (by decide) hj
  simp only [sumRange_succ, sumRange_zero, Nat.zero_add, Nat.pow_zero, Nat.mul_one,
    Nat.pow_one] at hA hB pA
  obtain ⟨sW, pW⟩ := pointsW_spec mul hmul a ao al b bo bl k 4 2 3 (by decide) (by decide)
    (fun j hj => match j, hj with | 0, _ | 1, _ | 2, _ | 3, _ => by decide | _ + 4, h => absurd h (by lia))
    (fun j hj => match j, hj with | 0, _ | 1, _ | 2, _ | 3, _ => by decide | _ + 4, h => absurd h (by lia))
    (by lia)
  have e₁ := pW 1 (by decide) (by decide)
  rw [show (1 - 1) * (k + k + 2) = 0 by lia] at e₁
  have e₂ := pW 2 (by decide) (by decide)
  rw [show (2 - 1) * (k + k + 2) = (k + k + 2) by lia] at e₂
  have e₃ := pW 3 (by decide) (by decide)
  rw [show (3 - 1) * (k + k + 2) = 2 * (k + k + 2) by lia] at e₃
  simp only [sumRange_succ, sumRange_zero, Nat.zero_add, Nat.pow_zero, Nat.mul_one,
    Nat.pow_one] at e₁ e₂ e₃
  have a₀ := piece_full a ao al k 0 (by lia)
  have aT := piece_top a ao al k 3 (by lia)
  have b₀ := piece_full b bo bl k 0 (by lia)
  have bT := piece_top b bo bl k 1 (by lia)
  simp only [Nat.zero_mul, Nat.add_zero, Nat.one_mul] at a₀ aT b₀ bT
  have lA₀ := piece_lt a ao al k 0
  have lA₁ := piece_lt a ao al k 1
  have lA₂ := piece_lt a ao al k 2
  have lA₃ := piece_lt a ao al k 3
  have lB₀ := piece_lt b bo bl k 0
  have lB₁ := piece_lt b bo bl k 1
  generalize piece a ao al k 0 = A₀ at *
  generalize piece a ao al k 1 = A₁ at *
  generalize piece a ao al k 2 = A₂ at *
  generalize piece a ao al k 3 = A₃ at *
  generalize piece b bo bl k 0 = B₀ at *
  generalize piece b bo bl k 1 = B₁ at *
  -- The products of the low pieces and of the top pieces.
  have p₁ : k + k < al + bl := by lia
  obtain ⟨w₁, v₁⟩ := hmul d o a ao k b bo k p₁ (by lia)
  rw [← a₀, ← b₀] at v₁
  generalize mul d o a ao k b bo k p₁ = d₁ at *
  have p₂ : al - 3 * k + (bl - k) < al + bl := by lia
  obtain ⟨w₂, v₂⟩ := hmul d₁ (o + 4 * k) a (ao + 3 * k) (al - 3 * k) b (bo + k)
    (bl - k) p₂ (by rw [w₁.1]; lia)
  rw [← aT, ← bT, show al - 3 * k + (bl - k) = al + bl - 4 * k by lia] at v₂
  rw [show al - 3 * k + (bl - k) = al + bl - 4 * k by lia] at w₂
  generalize mul d₁ (o + 4 * k) a (ao + 3 * k) (al - 3 * k) b (bo + k)
    (bl - k) p₂ = d₂ at *
  have hc₀ : valAt d₂ o (k + k) = A₀ * B₀ := by rw [← v₁]; exact w₂.valAt_eq (by lia)
  -- The values at the points.
  have p₃ : k + 1 + (k + 1) < al + bl := by lia
  -- The interpolation.
  generalize hX : 2 ^ (LA.w * k) = X at *
  have hX2 : 2 ^ (LA.w * (2 * k)) = X * X := by rw [pow_mul_k, hX]; grind
  have hX3 : 2 ^ (LA.w * (3 * k)) = X * X * X := by rw [pow_mul_k, hX]; grind
  have hX4 : 2 ^ (LA.w * (4 * k)) = X * X * X * X := by rw [pow_mul_k, hX]; grind
  have hval : valAt a ao al * valAt b bo bl =
      (A₀ * B₀) + X * (A₀ * B₁ + A₁ * B₀) + X * X * (A₁ * B₁ + A₂ * B₀) + X * X * X * (A₂ * B₁ + A₃ * B₀) + X * X * X * X * (A₃ * B₁) := by
    rw [hA, hB]; grind
  have hbm : (A₀ + A₁ * 3 + A₂ * 3 ^ 2 + A₃ * 3 ^ 3) * (B₀ + B₁ * 3) < 2 ^ (LA.w * (k + k + 2 - 1)) := by
    have h32 : 2 ^ 32 ≤ 2 ^ LA.w := Nat.pow_le_pow_right (by decide) R.w_ge
    rw [show 2 ^ (LA.w * (k + k + 2 - 1)) = X * X * 2 ^ LA.w by
      rw [← hX, ← Nat.pow_add, ← Nat.pow_add]; congr 1; lia]
    have := Nat.mul_lt_mul_of_lt_of_lt (show A₀ + A₁ * 3 + A₂ * 3 ^ 2 + A₃ * 3 ^ 3 < 40 * X by lia)
      (show B₀ + B₁ * 3 < 4 * X by lia)
    rw [show 40 * X * (4 * X) = 160 * (X * X) by grind] at this
    have := Nat.mul_le_mul_left (X * X) h32
    lia
  obtain ⟨f₁, f₂⟩ := interp4W_spec d₂ o (al + bl) k (k + k + 2) _ 
    (A₀ * B₀) (A₀ * B₁ + A₁ * B₀) (A₁ * B₁ + A₂ * B₀) (A₂ * B₁ + A₃ * B₀) (A₃ * B₁)
    (by rw [w₂.1, w₁.1]; exact hd) (by lia) (by lia) sW hc₀ v₂
    (by rw [e₁]; grind)
    (by rw [e₂]; grind)
    (by rw [e₃]; grind)
    (by refine Nat.lt_of_le_of_lt (Nat.le_of_eq ?_) hbm; grind)
    (by rw [hX, hX2, hX3, hX4, ← hval]; exact hab)
  rw [hX, hX2, hX3, hX4, ← hval] at f₂
  exact ⟨f₁.trans ((w₂.mono (by lia) (by lia)).trans (w₁.mono (by lia) (by lia))), f₂⟩

/--
The shape of Toom-3 by 2: 3 pieces of `k` limbs of `a` and 2 of `b`, at most, the top ones
nonempty.
-/
public abbrev Shape32 (al bl k : Nat) : Prop :=
  1 ≤ k ∧ 2 * k < al ∧ al ≤ 3 * k ∧ k < bl ∧ bl ≤ 2 * k

/--
Toom-3 by 2: `a` in 3 pieces of `k` limbs and `b` in 2, at most, the top ones nonempty, the values
and their products in windows of one array each (`pointsW`).
-/
@[expose, specialize] public def toom32 (d : A) (o : Nat) (a : A) (ao al : Nat) (b : A)
    (bo bl k : Nat) (hk : Shape32 al bl k) (mul : MulFn A (al + bl)) : A :=
  let d := mul d o a ao k b bo k (by obtain ⟨_, _, _, _, _⟩ := hk; lia)
  let d := mul d (o + 3 * k) a (ao + 2 * k) (al - 2 * k) b (bo + k)
    (bl - k) (by obtain ⟨_, _, _, _, _⟩ := hk; lia)
  interp3W d o (al + bl) k (k + k + 2)
    (pointsW mul a ao al b bo bl k 3 2 2 (by obtain ⟨_, _, _, _, _⟩ := hk; lia))

public theorem toom32_spec (d : A) (o : Nat) (a : A) (ao al : Nat) (b : A) (bo bl k : Nat)
    (hk : Shape32 al bl k) (mul : MulFn A (al + bl)) (hmul : IsMul mul)
    (hd : o + (al + bl) ≤ LA.size d) :
    Writes (toom32 d o a ao al b bo bl k hk mul) d o (al + bl) ∧
      valAt (toom32 d o a ao al b bo bl k hk mul) o (al + bl) = valAt a ao al * valAt b bo bl := by
  obtain ⟨hk₁, ha₁, ha₂, hb₁, hb₂⟩ := hk
  dsimp only [toom32]
  have hab := mul_lt a b ao al bo bl
  have hA := valAt_eq_pieces a k 3 ao al (by lia)
  have hB := valAt_eq_pieces b k 2 bo bl (by lia)
  have pA (j : Nat) (hj : 1 ≤ j) := point_spec mul hmul a ao al b bo bl k 3 2 j (by decide)
    (by decide) hj
  simp only [sumRange_succ, sumRange_zero, Nat.zero_add, Nat.pow_zero, Nat.mul_one,
    Nat.pow_one] at hA hB pA
  obtain ⟨sW, pW⟩ := pointsW_spec mul hmul a ao al b bo bl k 3 2 2 (by decide) (by decide)
    (fun j hj => match j, hj with | 0, _ | 1, _ | 2, _ => by decide | _ + 3, h => absurd h (by lia))
    (fun j hj => match j, hj with | 0, _ | 1, _ | 2, _ => by decide | _ + 3, h => absurd h (by lia))
    (by lia)
  have e₁ := pW 1 (by decide) (by decide)
  rw [show (1 - 1) * (k + k + 2) = 0 by lia] at e₁
  have e₂ := pW 2 (by decide) (by decide)
  rw [show (2 - 1) * (k + k + 2) = (k + k + 2) by lia] at e₂
  simp only [sumRange_succ, sumRange_zero, Nat.zero_add, Nat.pow_zero, Nat.mul_one,
    Nat.pow_one] at e₁ e₂
  have a₀ := piece_full a ao al k 0 (by lia)
  have aT := piece_top a ao al k 2 (by lia)
  have b₀ := piece_full b bo bl k 0 (by lia)
  have bT := piece_top b bo bl k 1 (by lia)
  simp only [Nat.zero_mul, Nat.add_zero, Nat.one_mul] at a₀ aT b₀ bT
  have lA₀ := piece_lt a ao al k 0
  have lA₁ := piece_lt a ao al k 1
  have lA₂ := piece_lt a ao al k 2
  have lB₀ := piece_lt b bo bl k 0
  have lB₁ := piece_lt b bo bl k 1
  generalize piece a ao al k 0 = A₀ at *
  generalize piece a ao al k 1 = A₁ at *
  generalize piece a ao al k 2 = A₂ at *
  generalize piece b bo bl k 0 = B₀ at *
  generalize piece b bo bl k 1 = B₁ at *
  -- The products of the low pieces and of the top pieces.
  have p₁ : k + k < al + bl := by lia
  obtain ⟨w₁, v₁⟩ := hmul d o a ao k b bo k p₁ (by lia)
  rw [← a₀, ← b₀] at v₁
  generalize mul d o a ao k b bo k p₁ = d₁ at *
  have p₂ : al - 2 * k + (bl - k) < al + bl := by lia
  obtain ⟨w₂, v₂⟩ := hmul d₁ (o + 3 * k) a (ao + 2 * k) (al - 2 * k) b (bo + k)
    (bl - k) p₂ (by rw [w₁.1]; lia)
  rw [← aT, ← bT, show al - 2 * k + (bl - k) = al + bl - 3 * k by lia] at v₂
  rw [show al - 2 * k + (bl - k) = al + bl - 3 * k by lia] at w₂
  generalize mul d₁ (o + 3 * k) a (ao + 2 * k) (al - 2 * k) b (bo + k)
    (bl - k) p₂ = d₂ at *
  have hc₀ : valAt d₂ o (k + k) = A₀ * B₀ := by rw [← v₁]; exact w₂.valAt_eq (by lia)
  -- The values at the points.
  have p₃ : k + 1 + (k + 1) < al + bl := by lia
  -- The interpolation.
  generalize hX : 2 ^ (LA.w * k) = X at *
  have hX2 : 2 ^ (LA.w * (2 * k)) = X * X := by rw [pow_mul_k, hX]; grind
  have hX3 : 2 ^ (LA.w * (3 * k)) = X * X * X := by rw [pow_mul_k, hX]; grind
  have hval : valAt a ao al * valAt b bo bl =
      (A₀ * B₀) + X * (A₀ * B₁ + A₁ * B₀) + X * X * (A₁ * B₁ + A₂ * B₀) + X * X * X * (A₂ * B₁) := by
    rw [hA, hB]; grind
  have hbm : (A₀ + A₁ * 2 + A₂ * 2 ^ 2) * (B₀ + B₁ * 2) < 2 ^ (LA.w * (k + k + 2 - 1)) := by
    have h32 : 2 ^ 32 ≤ 2 ^ LA.w := Nat.pow_le_pow_right (by decide) R.w_ge
    rw [show 2 ^ (LA.w * (k + k + 2 - 1)) = X * X * 2 ^ LA.w by
      rw [← hX, ← Nat.pow_add, ← Nat.pow_add]; congr 1; lia]
    have := Nat.mul_lt_mul_of_lt_of_lt (show A₀ + A₁ * 2 + A₂ * 2 ^ 2 < 7 * X by lia)
      (show B₀ + B₁ * 2 < 3 * X by lia)
    rw [show 7 * X * (3 * X) = 21 * (X * X) by grind] at this
    have := Nat.mul_le_mul_left (X * X) h32
