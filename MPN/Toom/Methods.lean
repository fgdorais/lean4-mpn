  have p₃ : k + 1 < al := by lia
  obtain ⟨s₁, e₁⟩ := pA 1 (by decide) (by decide) p₃
  obtain ⟨s₂, e₂⟩ := pA 2 (by decide) (by decide) p₃
  obtain ⟨s₃, e₃⟩ := pA 3 (by decide) (by decide) p₃
