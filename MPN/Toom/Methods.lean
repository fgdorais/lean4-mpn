/-- The shape of the toom-3 square: 3 pieces of `k` limbs, at most, the top one nonempty. -/
public abbrev Shape3S (al k : Nat) : Prop :=
  1 ≤ k ∧ 2 * k < al ∧ al ≤ 3 * k

/--
The Toom-3 square: `a` in 3 pieces of `k` limbs, at most, the top one nonempty, the values and their
squares in windows of one array each (`pointsSqrW`).
-/
@[expose, specialize] public def toom3Sqr (d : A) (o : Nat) (a : A) (ao al k : Nat)
    (hk : Shape3S al k) (sq : SqrFn A al) : A :=
  let d := sq d o a ao k (by obtain ⟨_, _, _⟩ := hk; lia)
  let d := sq d (o + 4 * k) a (ao + 2 * k) (al - 2 * k) (by obtain ⟨_, _, _⟩ := hk; lia)
  interp4W d o (al + al) k (k + k + 2) (pointsSqrW sq a ao al k 3 3 (by obtain ⟨_, _, _⟩ := hk; lia))

public theorem toom3Sqr_spec (d : A) (o : Nat) (a : A) (ao al k : Nat) (hk : Shape3S al k)
    (sq : SqrFn A al) (hsq : IsSqr sq) (hd : o + (al + al) ≤ LA.size d) :
    Writes (toom3Sqr d o a ao al k hk sq) d o (al + al) ∧
      valAt (toom3Sqr d o a ao al k hk sq) o (al + al) = valAt a ao al * valAt a ao al := by
  obtain ⟨hk₁, ha₁, ha₂⟩ := hk
  dsimp only [toom3Sqr]
  have hab := mul_lt a a ao al ao al
  have hA := valAt_eq_pieces a k 3 ao al (by lia)
  have pA (j : Nat) (hj : 1 ≤ j) := point_sqr_spec sq hsq a ao al k 3 j (by decide) hj
  simp only [sumRange_succ, sumRange_zero, Nat.zero_add, Nat.pow_zero, Nat.mul_one,
    Nat.pow_one] at hA pA
  obtain ⟨sW, pW⟩ := pointsSqrW_spec sq hsq a ao al k 3 3 (by decide)
    (fun j hj => match j, hj with | 0, _ | 1, _ | 2, _ | 3, _ => by decide | _ + 4, h => absurd h (by lia))
    (by lia)
  have e₁ := pW 1 (by decide) (by decide)
  rw [show (1 - 1) * (k + k + 2) = 0 by lia] at e₁
  have e₂ := pW 2 (by decide) (by decide)
  rw [show (2 - 1) * (k + k + 2) = (k + k + 2) by lia] at e₂
  have e₃ := pW 3 (by decide) (by decide)
