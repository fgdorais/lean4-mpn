  rw [show al - 2 * k + (al - 2 * k) = al + al - 4 * k by lia] at w₂
  generalize sq d₁ (o + 4 * k) a (ao + 2 * k) (al - 2 * k) p₂ = d₂ at *
  have hc₀ : valAt d₂ o (k + k) = A₀ * A₀ := by rw [← v₁]; exact w₂.valAt_eq (by lia)
